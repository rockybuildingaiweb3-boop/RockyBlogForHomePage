---
// Root page statically redirects to default locale /zh-CN
import { siteConfig } from '../config/site.config';
const targetUrl = `/${siteConfig.defaultLocale}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${targetUrl}`} />
    <link rel="canonical" href={`${siteConfig.siteUrl}${targetUrl}`} />
    <title>Redirecting to {siteConfig.siteName['zh-CN']}...</title>
  </head>
  <body class="bg-[#faf9f6] text-[#1a1a1a] flex min-h-screen items-center justify-center font-sans">
    <div class="text-center p-6">
      <h1 class="font-serif text-2xl font-bold mb-2">{siteConfig.siteName['zh-CN']}</h1>
      <p class="text-sm text-[#737373] mb-4">Redirecting to editorial publication...</p>
      <a href={targetUrl} class="text-xs font-mono underline hover:text-[#000000]">Click here if not redirected automatically</a>
    </div>
  </body>
</html>
