---
// Root page statically redirects to default locale /zh-CN
import { siteConfig } from '../config/site.config';
const targetUrl = `/${siteConfig.defaultLocale}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${targetUrl}`} />
    <link rel="canonical" href={`${siteConfig.siteUrl}${targetUrl}`} />
    <title>Redirecting to ROCKY — Software · AI · Design...</title>
  </head>
  <body class="bg-[#f9f8f5] text-[#1b1a18] flex min-h-screen items-center justify-center font-sans">
    <div class="text-center p-6 space-y-3">
      <h1 class="font-serif text-2xl font-bold tracking-tight">ROCKY</h1>
      <p class="text-xs font-mono text-[#88847b] uppercase tracking-wider">Personal Technical Journal · Software · AI · Design</p>
      <div class="pt-2">
        <a href={targetUrl} class="text-xs font-mono underline text-[#57544e] hover:text-[#1b1a18]">Click here if not redirected automatically</a>
      </div>
    </div>
  </body>
</html>
