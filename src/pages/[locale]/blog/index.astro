---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { ArrowUpRight } from 'lucide-react';
import { siteConfig } from '../../../config/site.config';
import { getTagDisplayName } from '../../../config/tags';
import { getArticlesByLocale } from '../../../lib/content';
import { calculateReadingMetrics } from '../../../lib/readingTime';
import { uiTranslations } from '../../../i18n/translations';
import type { SupportedLocale } from '../../../types/content';

export function getStaticPaths() {
  return siteConfig.supportedLocales.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: SupportedLocale };
const t = uiTranslations[locale];

const allPosts = await getCollection('blog');
const articles = getArticlesByLocale(allPosts, locale, false);

const alternateHreflangs: Record<SupportedLocale, string> = {
  'zh-CN': `${siteConfig.siteUrl}/zh-CN/blog`,
  'en': `${siteConfig.siteUrl}/en/blog`,
  'fr': `${siteConfig.siteUrl}/fr/blog`,
  'de': `${siteConfig.siteUrl}/de/blog`,
  'ja': `${siteConfig.siteUrl}/ja/blog`,
};

const translationLinks: Record<SupportedLocale, { url: string; available: boolean }> = {
  'zh-CN': { url: '/zh-CN/blog', available: true },
  'en': { url: '/en/blog', available: true },
  'fr': { url: '/fr/blog', available: true },
  'de': { url: '/de/blog', available: true },
  'ja': { url: '/ja/blog', available: true },
};

function getCoverSrc(cover: any): string {
  if (!cover) return '';
  return typeof cover === 'string' ? cover : cover.src;
}
---

<BaseLayout
  locale={locale}
  title={t.navBlog}
  description={t.latestArticlesSubtitle}
  canonicalUrl={`${siteConfig.siteUrl}/${locale}/blog`}
  alternateHreflangs={alternateHreflangs}
  translationLinks={translationLinks}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-8 lg:px-12 py-10 sm:py-16 space-y-16">
    <!-- Header Masthead -->
    <header class="border-b border-[#1b1a18] pb-8 space-y-4">
      <div class="flex items-center gap-3 text-xs font-mono uppercase tracking-widest text-[#88847b]">
        <span>INDEX 01</span>
        <span>·</span>
        <span>{articles.length} {articles.length === 1 ? 'RECORD' : 'RECORDS'} PUBLISHED</span>
      </div>
      <h1 class="font-serif text-4xl sm:text-6xl font-bold tracking-tight text-[#1b1a18]">
        {t.navBlog}
      </h1>
      <p class="font-serif text-lg text-[#57544e] max-w-2xl leading-relaxed">
        {t.latestArticlesSubtitle}
      </p>
    </header>

    {articles.length === 0 ? (
      <div class="py-20 text-center text-[#88847b] font-serif text-lg">
        {t.noArticlesFound}
      </div>
    ) : (
      <div class="space-y-16">
        <!-- Lead Essay -->
        {articles[0] && (
          <article class="group grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start border-b border-[#e6e2d8] pb-16">
            <div class="lg:col-span-7 space-y-5 order-2 lg:order-1">
              <div class="flex items-center gap-3 text-xs font-mono uppercase tracking-wider text-[#88847b]">
                <span class="font-bold text-[#1b1a18]">
                  01 / {siteConfig.categories.find((c) => c.id === articles[0].data.category)?.name[locale] || articles[0].data.category}
                </span>
                <span>·</span>
                <span>{articles[0].data.pubDate}</span>
                <span>·</span>
                <span>{t.readingTimeFormat(calculateReadingMetrics(articles[0].body || '', locale).minutes)}</span>
              </div>

              <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#1b1a18] leading-tight group-hover:text-[#1e3a5f] transition-colors">
                <a href={`/${locale}/blog/${articles[0].data.slug}`}>
                  {articles[0].data.title}
                </a>
              </h2>

              <p class="font-serif text-base text-[#57544e] leading-relaxed">
                {articles[0].data.description}
              </p>

              <div class="flex items-center justify-between pt-4">
                <div class="flex flex-wrap gap-2 text-xs font-mono text-[#88847b]">
                  {articles[0].data.tags.map((tag: string) => (
                    <a href={`/${locale}/tag/${tag}`} class="hover:text-[#1b1a18]">
                      #{getTagDisplayName(tag, locale)}
                    </a>
                  ))}
                </div>

                <a
                  href={`/${locale}/blog/${articles[0].data.slug}`}
                  class="inline-flex items-center gap-1 text-xs font-mono uppercase tracking-wider text-[#1b1a18] group-hover:underline underline-offset-4"
                >
                  <span>Read</span>
                  <ArrowUpRight className="h-3.5 w-3.5" />
                </a>
              </div>
            </div>

            <div class="lg:col-span-5 order-1 lg:order-2">
              <a
                href={`/${locale}/blog/${articles[0].data.slug}`}
                class="block overflow-hidden border border-[#e6e2d8] bg-[#e8e4db] aspect-[16/11]"
              >
                <img
                  src={getCoverSrc(articles[0].data.cover)}
                  alt={articles[0].data.coverAlt || articles[0].data.title}
                  loading="eager"
                  class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                />
              </a>
            </div>
          </article>
        )}

        <!-- Dispatches Catalog List -->
        {articles.length > 1 && (
          <div class="space-y-6">
            <div class="text-[11px] font-mono uppercase tracking-widest text-[#88847b] border-b border-[#e6e2d8] pb-2">
              All Dispatches in this Edition
            </div>
            <div class="divide-y divide-[#e6e2d8]">
              {articles.slice(1).map((article, idx) => {
                const readingMin = calculateReadingMetrics(article.body || '', locale).minutes;
                return (
                  <article class="group py-8 grid grid-cols-1 md:grid-cols-12 gap-6 items-baseline hover:bg-[#f3f0e8]/50 px-2 -mx-2 transition-colors">
                    <div class="md:col-span-3 space-y-1 font-mono text-xs">
                      <div class="text-[#1b1a18] font-medium">{article.data.pubDate}</div>
                      <div class="text-[11px] uppercase tracking-wider text-[#88847b]">
                        0{idx + 2} / {siteConfig.categories.find((c) => c.id === article.data.category)?.name[locale] || article.data.category}
                      </div>
                      <div class="text-[10px] text-[#a5a095]">
                        {t.readingTimeFormat(readingMin)}
                      </div>
                    </div>

                    <div class="md:col-span-7 space-y-2">
                      <h3 class="font-serif text-xl sm:text-2xl font-bold text-[#1b1a18] leading-snug group-hover:text-[#1e3a5f] transition-colors">
                        <a href={`/${locale}/blog/${article.data.slug}`}>
                          {article.data.title}
                        </a>
                      </h3>
                      <p class="font-serif text-sm text-[#57544e] leading-relaxed line-clamp-2">
                        {article.data.description}
                      </p>
                      <div class="flex flex-wrap gap-x-3 gap-y-1 pt-1 text-[11px] font-mono text-[#88847b]">
                        {article.data.tags.map((tag: string) => (
                          <a href={`/${locale}/tag/${tag}`} class="hover:text-[#1b1a18]">
                            #{getTagDisplayName(tag, locale)}
                          </a>
                        ))}
                      </div>
                    </div>

                    <div class="hidden md:flex md:col-span-2 justify-end">
                      <a
                        href={`/${locale}/blog/${article.data.slug}`}
                        class="inline-flex items-center gap-1 text-xs font-mono uppercase tracking-wider text-[#88847b] group-hover:text-[#1b1a18] group-hover:translate-x-1 transition-all"
                      >
                        <span>Read</span>
                        <ArrowUpRight className="h-3 w-3" />
                      </a>
                    </div>
                  </article>
                );
              })}
            </div>
          </div>
        )}
      </div>
    )}
  </div>
</BaseLayout>
