---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { siteConfig } from '../../../config/site.config';
import { getArticlesByLocale } from '../../../lib/content';
import { calculateReadingMetrics } from '../../../lib/readingTime';
import { uiTranslations } from '../../../i18n/translations';
import type { SupportedLocale } from '../../../types/content';

export function getStaticPaths() {
  return siteConfig.supportedLocales.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: SupportedLocale };
const t = uiTranslations[locale];

const allPosts = await getCollection('blog');
const articles = getArticlesByLocale(allPosts, locale, false);

const alternateHreflangs: Record<SupportedLocale, string> = {
  'zh-CN': `${siteConfig.siteUrl}/zh-CN/blog`,
  'en': `${siteConfig.siteUrl}/en/blog`,
  'fr': `${siteConfig.siteUrl}/fr/blog`,
  'de': `${siteConfig.siteUrl}/de/blog`,
  'ja': `${siteConfig.siteUrl}/ja/blog`,
};

const translationLinks: Record<SupportedLocale, { url: string; available: boolean }> = {
  'zh-CN': { url: '/zh-CN/blog', available: true },
  'en': { url: '/en/blog', available: true },
  'fr': { url: '/fr/blog', available: true },
  'de': { url: '/de/blog', available: true },
  'ja': { url: '/ja/blog', available: true },
};

function getCoverSrc(cover: any): string {
  if (!cover) return '';
  return typeof cover === 'string' ? cover : cover.src;
}
---

<BaseLayout
  locale={locale}
  title={t.navBlog}
  description={t.latestArticlesSubtitle}
  canonicalUrl={`${siteConfig.siteUrl}/${locale}/blog`}
  alternateHreflangs={alternateHreflangs}
  translationLinks={translationLinks}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-8 lg:px-12 py-8 sm:py-12 space-y-12">
    <header class="border-b border-[#e5e5e0] pb-8">
      <h1 class="font-serif text-3xl sm:text-5xl font-bold tracking-tight text-[#1a1a1a]">
        {t.navBlog}
      </h1>
      <p class="font-serif text-lg text-[#525252] mt-3 max-w-2xl">
        {t.latestArticlesSubtitle}
      </p>
    </header>

    {articles.length === 0 ? (
      <div class="py-12 text-center text-[#737373] font-serif">
        {t.noArticlesFound}
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
        {articles.map((article) => {
          const readingMin = calculateReadingMetrics(article.body || '', locale).minutes;
          return (
            <article class="group flex flex-col justify-between">
              <div class="space-y-4">
                <a
                  href={`/${locale}/blog/${article.data.slug}`}
                  class="aspect-[16/10] overflow-hidden rounded-sm bg-[#e8e6e1] block"
                >
                  <img
                    src={getCoverSrc(article.data.cover)}
                    alt={article.data.coverAlt || article.data.title}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                </a>
                <div class="flex items-center justify-between text-[11px] font-semibold tracking-wider uppercase text-[#737373]">
                  <span>{siteConfig.categories.find((c) => c.id === article.data.category)?.name[locale] || article.data.category}</span>
                  <span class="font-mono text-[#a3a3a3]">{article.data.pubDate}</span>
                </div>
                <h2 class="font-serif text-xl font-bold text-[#1a1a1a] group-hover:underline leading-snug">
                  <a href={`/${locale}/blog/${article.data.slug}`}>
                    {article.data.title}
                  </a>
                </h2>
                <p class="font-serif text-sm text-[#525252] line-clamp-3 leading-relaxed">
                  {article.data.description}
                </p>
              </div>

              <div class="mt-6 pt-4 border-t border-[#ecebe6] flex items-center justify-between text-xs font-mono text-[#737373]">
                <span>{t.readingTimeFormat(readingMin)}</span>
                <a
                  href={`/${locale}/blog/${article.data.slug}`}
                  class="text-[#1a1a1a] group-hover:translate-x-1 transition-transform"
                >
                  Read →
                </a>
              </div>
            </article>
          );
        })}
      </div>
    )}
  </div>
</BaseLayout>
