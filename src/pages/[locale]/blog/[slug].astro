---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { ArrowLeft } from 'lucide-react';
import { Figure } from '../../../components/mdx/Figure';
import { Note } from '../../../components/mdx/Note';
import TableOfContents from '../../../components/article/TableOfContents.astro';
import { AlsoPublishedOn } from '../../../components/article/AlsoPublishedOn';
import { PreviousNext } from '../../../components/article/PreviousNext';
import { RelatedArticles } from '../../../components/article/RelatedArticles';
import { siteConfig } from '../../../config/site.config';
import { getTagDisplayName } from '../../../config/tags';
import {
  getTranslationsForArticle,
  getRelatedArticles,
  getAdjacentArticles,
  validateContentIntegrity,
} from '../../../lib/content';
import { calculateReadingMetrics } from '../../../lib/readingTime';
import { uiTranslations } from '../../../i18n/translations';
import type { SupportedLocale, TocItem } from '../../../types/content';

export async function getStaticPaths() {
  const entries = await getCollection('blog');
  validateContentIntegrity(entries);
  const published = entries.filter((e) => !e.data.draft);

  return published.map((entry) => ({
    params: {
      locale: entry.data.lang,
      slug: entry.data.slug,
    },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { locale } = Astro.params as { locale: SupportedLocale; slug: string };
const t = uiTranslations[locale];

const { Content, headings } = await render(entry);

const allPosts = await getCollection('blog');
const translations = getTranslationsForArticle(allPosts, entry.data.translationId);
const relatedArticlesRaw = getRelatedArticles(entry, allPosts, 3);
const { previous: prevEntry, next: nextEntry } = getAdjacentArticles(entry, allPosts);

const readingMin = calculateReadingMetrics(entry.body || '', locale).minutes;

const relatedArticles = relatedArticlesRaw.map((rel) => ({
  slug: rel.data.slug,
  lang: rel.data.lang,
  title: rel.data.title,
  description: rel.data.description,
  category: rel.data.category,
  cover: typeof rel.data.cover === 'string' ? rel.data.cover : rel.data.cover.src,
  pubDate: rel.data.pubDate,
  readingTimeMinutes: calculateReadingMetrics(rel.body || '', rel.data.lang).minutes,
}));

const previous = prevEntry
  ? {
      slug: prevEntry.data.slug,
      lang: prevEntry.data.lang,
      title: prevEntry.data.title,
    }
  : undefined;

const next = nextEntry
  ? {
      slug: nextEntry.data.slug,
      lang: nextEntry.data.lang,
      title: nextEntry.data.title,
    }
  : undefined;

// Build Table of Contents items from Astro headings
const tocItems: TocItem[] = headings
  .filter((h) => h.depth >= 2 && h.depth <= 4)
  .map((h) => ({
    id: h.slug,
    text: h.text,
    depth: h.depth as 2 | 3 | 4,
  }));

const alternateHreflangs: Record<string, string> = {};
const translationLinks: Record<SupportedLocale, { url: string; available: boolean }> = {
  'zh-CN': { url: '/zh-CN/blog', available: false },
  'en': { url: '/en/blog', available: false },
  'fr': { url: '/fr/blog', available: false },
  'de': { url: '/de/blog', available: false },
  'ja': { url: '/ja/blog', available: false },
};

for (const loc of siteConfig.supportedLocales) {
  const translation = translations[loc];
  if (translation) {
    const url = `${siteConfig.siteUrl}/${loc}/blog/${translation.data.slug}`;
    alternateHreflangs[loc] = url;
    translationLinks[loc] = {
      url: `/${loc}/blog/${translation.data.slug}`,
      available: true,
    };
  }
}

const canonicalUrl =
  entry.data.canonicalUrl && entry.data.canonicalUrl.trim().length > 0
    ? entry.data.canonicalUrl.trim()
    : `${siteConfig.siteUrl}/${locale}/blog/${entry.data.slug}`;

const coverSrc = typeof entry.data.cover === 'string' ? entry.data.cover : (entry.data.cover as any)?.src;
const coverAbsoluteUrl = coverSrc
  ? coverSrc.startsWith('http://') || coverSrc.startsWith('https://')
    ? coverSrc
    : `${siteConfig.siteUrl}${coverSrc.startsWith('/') ? '' : '/'}${coverSrc}`
  : undefined;

const coverAltText = entry.data.coverAlt || entry.data.title;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.pubDate,
  dateModified: entry.data.updatedDate || entry.data.pubDate,
  author: {
    '@type': 'Person',
    name: entry.data.author || siteConfig.author.name,
  },
  publisher: {
    '@type': 'Organization',
    name: siteConfig.siteName[locale],
    logo: {
      '@type': 'ImageObject',
      url: `${siteConfig.siteUrl}/favicon.svg`,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
  ...(coverAbsoluteUrl ? { image: coverAbsoluteUrl } : {}),
};
---

<BaseLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.description}
  canonicalUrl={canonicalUrl}
  alternateHreflangs={alternateHreflangs}
  ogImage={coverAbsoluteUrl}
  ogType="article"
  articleDate={entry.data.pubDate}
  articleModifiedDate={entry.data.updatedDate || entry.data.pubDate}
  authorName={entry.data.author || siteConfig.author.name}
  jsonLd={jsonLd}
  translationLinks={translationLinks}
>
  <article class="mx-auto max-w-7xl px-4 sm:px-8 lg:px-12 py-10 sm:py-16">
    <!-- Back to Category Navigation -->
    <div class="mb-10">
      <a
        href={`/${locale}/category/${entry.data.category}`}
        class="group inline-flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-[#88847b] hover:text-[#1b1a18] transition-colors"
      >
        <ArrowLeft className="h-3 w-3 transition-transform group-hover:-translate-x-1" />
        <span>01 / {siteConfig.categories.find((c) => c.id === entry.data.category)?.name[locale] || entry.data.category}</span>
      </a>
    </div>

    <!-- Editorial Article Header (Masthead) -->
    <header class="max-w-4xl space-y-6">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs font-mono text-[#88847b]">
        <span class="font-bold uppercase text-[#1b1a18]">
          {siteConfig.categories.find((c) => c.id === entry.data.category)?.name[locale] || entry.data.category}
        </span>
        <span>·</span>
        <time datetime={entry.data.pubDate}>{entry.data.pubDate}</time>
        {entry.data.updatedDate && (
          <span class="text-[#a5a095]" title="Last revised">
            (rev: {entry.data.updatedDate})
          </span>
        )}
        <span>·</span>
        <span>{t.readingTimeFormat(readingMin)}</span>
        <span>·</span>
        <span>ID: {entry.data.slug}</span>
      </div>

      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-[#1b1a18] leading-[1.1]">
        {entry.data.title}
      </h1>

      <div class="border-l-2 border-[#1b1a18] pl-6 py-1 my-6">
        <p class="font-serif text-xl sm:text-2xl text-[#57544e] leading-relaxed italic">
          {entry.data.description}
        </p>
      </div>

      <!-- Parallel Editions Translation Bar -->
      <div class="pt-6 border-t border-[#e6e2d8] flex flex-wrap items-center gap-x-4 gap-y-2 text-xs font-mono">
        <span class="text-[#88847b] uppercase tracking-wider">
          {t.availableIn}:
        </span>
        <div class="flex items-center gap-2.5">
          {siteConfig.supportedLocales.map((loc, idx) => {
            const isCurrent = loc === locale;
            const linkInfo = translationLinks[loc];
            const hasTranslation = linkInfo ? linkInfo.available : false;
            const shortCode = loc === 'zh-CN' ? 'ZH' : loc.toUpperCase();

            return (
              <div class="flex items-center gap-2.5">
                {idx > 0 && <span class="text-[#d3cebf]">/</span>}
                {isCurrent ? (
                  <span class="font-bold text-[#1b1a18] underline underline-offset-4 decoration-1 decoration-[#1b1a18]">
                    {shortCode}
                  </span>
                ) : hasTranslation ? (
                  <a
                    href={linkInfo.url}
                    class="text-[#88847b] hover:text-[#1b1a18] transition-colors"
                  >
                    {shortCode}
                  </a>
                ) : (
                  <span
                    title={t.translationMissing}
                    class="text-[#c8c4b7] line-through cursor-not-allowed"
                  >
                    {shortCode}
                  </span>
                )}
              </div>
            );
          })}
        </div>
      </div>
    </header>

    <!-- Cover Plate Hero Image -->
    {coverSrc && (
      <div class="my-12">
        <div class="overflow-hidden border border-[#e6e2d8] bg-[#e8e4db] aspect-[16/9] max-h-[640px]">
          <img
            src={coverSrc}
            alt={coverAltText}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="h-full w-full object-cover"
          />
        </div>
        <div class="mt-2.5 flex items-baseline justify-between text-[10px] font-mono text-[#88847b]">
          <span>PLATE 01. {entry.data.slug}</span>
          <span>{entry.data.coverAlt || 'Architecture & Engineering Visual Plate'}</span>
        </div>
      </div>
    )}

    <!-- Main Content + Marginalia TOC Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <!-- Article Text Stream (8 cols) -->
      <main class="lg:col-span-8 min-w-0 max-w-[68ch]">
        <div class="editorial-prose">
          <Content components={{ Figure, Note }} />
        </div>

        <!-- Topics / Tags Index -->
        <div class="mt-16 pt-8 border-t border-[#e6e2d8] flex flex-wrap items-baseline gap-3 text-xs font-mono">
          <span class="uppercase tracking-widest text-[#88847b]">
            {t.tagsLabel}:
          </span>
          {entry.data.tags.map((tag: string) => (
            <a
              href={`/${locale}/tag/${tag}`}
              class="text-[#57544e] hover:text-[#1b1a18] underline underline-offset-4 decoration-[#cfc9be] hover:decoration-[#1b1a18] transition-colors"
            >
              #{getTagDisplayName(tag, locale)}
            </a>
          ))}
        </div>

        <!-- Author Colophon Inscription -->
        <div class="my-12 border-t border-b border-[#e6e2d8] py-8 flex items-start gap-6">
          <div class="h-14 w-14 shrink-0 overflow-hidden border border-[#e6e2d8] bg-[#e8e4db]">
            <img
              src={siteConfig.author.avatar}
              alt={siteConfig.author.name}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover"
            />
          </div>
          <div class="space-y-1.5 text-xs">
            <div class="text-[10px] font-mono uppercase tracking-widest text-[#88847b]">
              AUTHOR
            </div>
            <div class="font-serif text-base font-bold text-[#1b1a18]">
              {entry.data.author || siteConfig.author.name}
            </div>
            <div class="font-serif text-sm text-[#57544e] leading-relaxed max-w-xl">
              {siteConfig.author.bio[locale]}
            </div>
          </div>
        </div>

        <!-- Also Published On external link plate -->
        {entry.data.links && entry.data.links.length > 0 && (
          <AlsoPublishedOn links={entry.data.links} label={t.alsoPublishedOn} />
        )}

        <!-- Previous & Next Chronology -->
        <PreviousNext
          previous={previous}
          next={next}
          prevLabel={t.previousArticle}
          nextLabel={t.nextArticle}
        />

        <!-- Related Inquiries -->
        {relatedArticles.length > 0 && (
          <RelatedArticles
            articles={relatedArticles}
            heading={t.relatedArticles}
          />
        )}
      </main>

      <!-- Sticky Marginalia Index (TOC) -->
      {tocItems.length > 0 && (
        <aside class="hidden lg:block lg:col-span-4 sticky top-20">
          <TableOfContents
            items={tocItems}
            titleLabel={t.tableOfContents}
          />
        </aside>
      )}
    </div>
  </article>
</BaseLayout>
