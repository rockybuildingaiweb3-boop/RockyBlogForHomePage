---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { ArrowLeft, Calendar, Clock, Globe } from 'lucide-react';
import { Figure } from '../../../components/mdx/Figure';
import { Note } from '../../../components/mdx/Note';
import TableOfContents from '../../../components/article/TableOfContents.astro';
import { AlsoPublishedOn } from '../../../components/article/AlsoPublishedOn';
import { PreviousNext } from '../../../components/article/PreviousNext';
import { RelatedArticles } from '../../../components/article/RelatedArticles';
import { siteConfig } from '../../../config/site.config';
import { getTagDisplayName } from '../../../config/tags';
import {
  getTranslationsForArticle,
  getRelatedArticles,
  getAdjacentArticles,
  validateContentIntegrity,
} from '../../../lib/content';
import { calculateReadingMetrics } from '../../../lib/readingTime';
import { localeDisplayNames, uiTranslations } from '../../../i18n/translations';
import type { SupportedLocale, TocItem } from '../../../types/content';

export async function getStaticPaths() {
  const entries = await getCollection('blog');
  validateContentIntegrity(entries);
  const published = entries.filter((e) => !e.data.draft);

  return published.map((entry) => ({
    params: {
      locale: entry.data.lang,
      slug: entry.data.slug,
    },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { locale } = Astro.params as { locale: SupportedLocale; slug: string };
const t = uiTranslations[locale];

const { Content, headings } = await render(entry);

const allPosts = await getCollection('blog');
const translations = getTranslationsForArticle(allPosts, entry.data.translationId);
const relatedArticlesRaw = getRelatedArticles(entry, allPosts, 3);
const { previous: prevEntry, next: nextEntry } = getAdjacentArticles(entry, allPosts);

const readingMin = calculateReadingMetrics(entry.body || '', locale).minutes;

const relatedArticles = relatedArticlesRaw.map((rel) => ({
  slug: rel.data.slug,
  lang: rel.data.lang,
  title: rel.data.title,
  description: rel.data.description,
  category: rel.data.category,
  cover: typeof rel.data.cover === 'string' ? rel.data.cover : rel.data.cover.src,
  pubDate: rel.data.pubDate,
  readingTimeMinutes: calculateReadingMetrics(rel.body || '', rel.data.lang).minutes,
}));

const previous = prevEntry
  ? {
      slug: prevEntry.data.slug,
      lang: prevEntry.data.lang,
      title: prevEntry.data.title,
    }
  : undefined;

const next = nextEntry
  ? {
      slug: nextEntry.data.slug,
      lang: nextEntry.data.lang,
      title: nextEntry.data.title,
    }
  : undefined;

// Build Table of Contents items from Astro headings
const tocItems: TocItem[] = headings
  .filter((h) => h.depth >= 2 && h.depth <= 4)
  .map((h) => ({
    id: h.slug,
    text: h.text,
    depth: h.depth as 2 | 3 | 4,
  }));

// Precompute alternate hreflangs and translation navigation links
// Strictly Section 5.1 & 5.2: Only emit hreflang for languages where a translation truly exists!
const alternateHreflangs: Record<string, string> = {};
const translationLinks: Record<SupportedLocale, { url: string; available: boolean }> = {
  'zh-CN': { url: '/zh-CN/blog', available: false },
  'en': { url: '/en/blog', available: false },
  'fr': { url: '/fr/blog', available: false },
  'de': { url: '/de/blog', available: false },
  'ja': { url: '/ja/blog', available: false },
};

for (const loc of siteConfig.supportedLocales) {
  const translation = translations[loc];
  if (translation) {
    const url = `${siteConfig.siteUrl}/${loc}/blog/${translation.data.slug}`;
    alternateHreflangs[loc] = url;
    translationLinks[loc] = {
      url: `/${loc}/blog/${translation.data.slug}`,
      available: true,
    };
  }
}

// Canonical URL resolution per Section 4.1:
// If canonicalUrl is explicitly provided (e.g. cross-posted from another authoritative source), preserve it.
// Otherwise, default to this article's own absolute URL.
const canonicalUrl =
  entry.data.canonicalUrl && entry.data.canonicalUrl.trim().length > 0
    ? entry.data.canonicalUrl.trim()
    : `${siteConfig.siteUrl}/${locale}/blog/${entry.data.slug}`;

const coverSrc = typeof entry.data.cover === 'string' ? entry.data.cover : (entry.data.cover as any)?.src;
const coverAbsoluteUrl = coverSrc
  ? coverSrc.startsWith('http://') || coverSrc.startsWith('https://')
    ? coverSrc
    : `${siteConfig.siteUrl}${coverSrc.startsWith('/') ? '' : '/'}${coverSrc}`
  : undefined;

const coverAltText = entry.data.coverAlt || entry.data.title;

// JSON-LD Schema.org BlogPosting metadata
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.pubDate,
  dateModified: entry.data.updatedDate || entry.data.pubDate,
  author: {
    '@type': 'Person',
    name: entry.data.author || siteConfig.author.name,
  },
  publisher: {
    '@type': 'Organization',
    name: siteConfig.siteName[locale],
    logo: {
      '@type': 'ImageObject',
      url: `${siteConfig.siteUrl}/favicon.svg`,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
  ...(coverAbsoluteUrl ? { image: coverAbsoluteUrl } : {}),
};
---

<BaseLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.description}
  canonicalUrl={canonicalUrl}
  alternateHreflangs={alternateHreflangs}
  ogImage={coverAbsoluteUrl}
  ogType="article"
  articleDate={entry.data.pubDate}
  articleModifiedDate={entry.data.updatedDate || entry.data.pubDate}
  authorName={entry.data.author || siteConfig.author.name}
  jsonLd={jsonLd}
  translationLinks={translationLinks}
>
  <article class="mx-auto max-w-7xl px-4 sm:px-8 lg:px-12 py-8 sm:py-12">
    <!-- Back to Category / Blog Navigation Link -->
    <div class="mb-8">
      <a
        href={`/${locale}/category/${entry.data.category}`}
        class="inline-flex items-center gap-1.5 text-xs font-mono uppercase tracking-widest text-[#737373] hover:text-[#1a1a1a] transition-colors"
      >
        <ArrowLeft className="h-3.5 w-3.5" />
        <span>{siteConfig.categories.find((c) => c.id === entry.data.category)?.name[locale] || entry.data.category}</span>
      </a>
    </div>

    <!-- Article Header -->
    <header class="max-w-4xl space-y-6">
      <div class="flex flex-wrap items-center gap-4 text-xs font-mono text-[#737373]">
        <span class="flex items-center gap-1.5">
          <Calendar className="h-3.5 w-3.5" />
          <time datetime={entry.data.pubDate}>{entry.data.pubDate}</time>
          {entry.data.updatedDate && (
            <span class="text-[11px] text-[#a3a3a3]" title="Last updated">
              (rev: {entry.data.updatedDate})
            </span>
          )}
        </span>
        <span>•</span>
        <span class="flex items-center gap-1.5">
          <Clock className="h-3.5 w-3.5" />
          <span>{t.readingTimeFormat(readingMin)}</span>
        </span>
        <span>•</span>
        <span class="uppercase tracking-wider px-2 py-0.5 bg-[#f0eee9] text-[#525252] rounded-xs text-[11px]">
          {siteConfig.categories.find((c) => c.id === entry.data.category)?.name[locale] || entry.data.category}
        </span>
      </div>

      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-[#1a1a1a] leading-[1.12]">
        {entry.data.title}
      </h1>

      <p class="font-serif text-lg sm:text-xl text-[#525252] leading-relaxed">
        {entry.data.description}
      </p>

      <!-- Cross-Language Translation Bar -->
      <div class="pt-4 border-t border-[#e5e5e0] flex flex-wrap items-center gap-3 text-xs">
        <span class="flex items-center gap-1 text-[#737373] font-medium">
          <Globe className="h-3.5 w-3.5" />
          <span>{t.availableIn}:</span>
        </span>
        {siteConfig.supportedLocales.map((loc) => {
          const isCurrent = loc === locale;
          const linkInfo = translationLinks[loc];
          const hasTranslation = linkInfo ? linkInfo.available : false;

          if (isCurrent) {
            return (
              <span class="px-2.5 py-1 bg-[#1a1a1a] text-[#faf9f6] font-medium rounded-sm">
                {localeDisplayNames[loc]}
              </span>
            );
          }

          if (hasTranslation) {
            return (
              <a
                href={linkInfo.url}
                class="px-2.5 py-1 border border-[#e5e5e0] text-[#525252] hover:border-[#1a1a1a] hover:text-[#1a1a1a] bg-[#faf9f6] font-medium rounded-sm transition-colors"
              >
                {localeDisplayNames[loc]}
              </a>
            );
          }

          return (
            <span
              title={t.translationMissing}
              class="px-2.5 py-1 text-[#a3a3a3] line-through decoration-[#d4d4d4] cursor-not-allowed text-[11px]"
            >
              {localeDisplayNames[loc]}
            </span>
          );
        })}
      </div>
    </header>

    <!-- Hero Cover Image (LCP optimized with eager loading & high priority) -->
    {coverSrc && (
      <div class="my-12 -mx-4 sm:-mx-8 lg:-mx-12 overflow-hidden rounded-sm bg-[#e8e6e1] aspect-[16/9] max-h-[680px]">
        <img
          src={coverSrc}
          alt={coverAltText}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="h-full w-full object-cover"
        />
      </div>
    )}

    <!-- Main Content + Table of Contents Sticky Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <main class="lg:col-span-8 min-w-0">
        <div class="article-content font-serif text-[#262626] text-lg sm:text-xl leading-[1.8] space-y-6">
          <Content components={{ Figure, Note }} />
        </div>

        <!-- Tags -->
        <div class="mt-16 pt-8 border-t border-[#e5e5e0] flex flex-wrap gap-2">
          <span class="text-xs uppercase tracking-widest text-[#737373] self-center mr-2">
            {t.tagsLabel}:
          </span>
          {entry.data.tags.map((tag: string) => (
            <a
              href={`/${locale}/tag/${tag}`}
              class="text-xs font-mono text-[#525252] bg-[#f5f4ef] hover:bg-[#e8e6e1] px-3 py-1 rounded-sm transition-colors"
            >
              #{getTagDisplayName(tag, locale)}
            </a>
          ))}
        </div>

        <!-- Author Byline -->
        <div class="my-12 rounded-sm border border-[#e5e5e0] bg-[#faf9f6] p-6 flex items-start gap-4">
          <div class="h-12 w-12 rounded-full overflow-hidden bg-[#e8e6e1] shrink-0">
            <img
              src={siteConfig.author.avatar}
              alt={siteConfig.author.name}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover"
            />
          </div>
          <div class="space-y-1 text-sm">
            <div class="font-serif font-bold text-[#1a1a1a]">
              {entry.data.author || siteConfig.author.name}
            </div>
            <div class="font-serif text-xs text-[#525252] leading-relaxed">
              {siteConfig.author.bio[locale]}
            </div>
          </div>
        </div>

        <!-- Also Published On -->
        {entry.data.links && entry.data.links.length > 0 && (
          <AlsoPublishedOn links={entry.data.links} label={t.alsoPublishedOn} />
        )}

        <!-- Previous & Next Navigation -->
        <PreviousNext
          previous={previous}
          next={next}
          prevLabel={t.previousArticle}
          nextLabel={t.nextArticle}
        />

        <!-- Related Articles -->
        {relatedArticles.length > 0 && (
          <RelatedArticles
            articles={relatedArticles}
            heading={t.relatedArticles}
          />
        )}
      </main>

      <!-- Sticky Table of Contents Sidebar (Pure static Astro component, 0 React Hydration) -->
      {tocItems.length > 0 && (
        <aside class="hidden lg:block lg:col-span-4 sticky top-24">
          <TableOfContents
            items={tocItems}
            titleLabel={t.tableOfContents}
          />
        </aside>
      )}
    </div>
  </article>
</BaseLayout>
