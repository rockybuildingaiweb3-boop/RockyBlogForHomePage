---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { ArrowUpRight } from 'lucide-react';
import { siteConfig } from '../../../config/site.config';
import { uiTranslations } from '../../../i18n/translations';
import type { SupportedLocale } from '../../../types/content';

export function getStaticPaths() {
  return siteConfig.supportedLocales.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: SupportedLocale };
const t = uiTranslations[locale];

const canonicalUrl = `${siteConfig.siteUrl}/${locale}/about`;

const alternateHreflangs: Record<SupportedLocale, string> = {
  'zh-CN': `${siteConfig.siteUrl}/zh-CN/about`,
  'en': `${siteConfig.siteUrl}/en/about`,
  'fr': `${siteConfig.siteUrl}/fr/about`,
  'de': `${siteConfig.siteUrl}/de/about`,
  'ja': `${siteConfig.siteUrl}/ja/about`,
};

const translationLinks: Record<SupportedLocale, { url: string; available: boolean }> = {
  'zh-CN': { url: '/zh-CN/about', available: true },
  'en': { url: '/en/about', available: true },
  'fr': { url: '/fr/about', available: true },
  'de': { url: '/de/about', available: true },
  'ja': { url: '/ja/about', available: true },
};

const aboutCopy: Record<
  SupportedLocale,
  {
    badge: string;
    whoTitle: string;
    whoText: string;
    focusTitle: string;
    focusItems: Array<{ title: string; desc: string }>;
    whyTitle: string;
    whyText: string;
    stackTitle: string;
    stackText: string;
    stackItems: string[];
    contactTitle: string;
    noContact: string;
  }
> = {
  'zh-CN': {
    badge: '工程实践 · 知识架构',
    whoTitle: '关于作者与工程背景',
    whoText: '专注于系统架构、AI 智能体工程落地与现代前端 Web 技术的软件工程师。长期从事高可用系统设计与研发效能实践。',
    focusTitle: '核心专注领域',
    focusItems: [
      { title: '软件工程与系统架构', desc: '关注分布式系统的可维护性、模块演进、接口契约与长期稳定性实践。' },
      { title: 'AI、LLM 与自律智能体', desc: '探索大语言模型在生产工程中的落地架构、Agent 工作流、工具调用与评估体系。' },
      { title: '现代前端与渲染性能', desc: '深度理解浏览器内部运作、静态编译与现代框架（Astro/React）的最佳平衡。' },
      { title: '设计系统与用户体验', desc: '融合出版物排版美学与严苛的数字工程规范，追求高信息密度与无障碍访问。' },
      { title: '技术复盘与实验记录', desc: '记录真实的疑难排错（Troubleshooting）、工程折衷（Trade-offs）与踩坑教训。' },
    ],
    whyTitle: '为什么构建这个知识系统',
    whyText: '面对信息爆炸与社交媒体碎片化的当下，建立一个完全由自己掌控、面向未来 5–10 年的个人知识沉淀体系。不追逐瞬时流量，只记录经得起时间检验的工程实践与深度思考。',
    stackTitle: '网站系统架构与技术选型',
    stackText: '坚决执行“纯静态优先（Static by Default）”与“长寿架构”原则：',
    stackItems: [
      'Astro 驱动的高性能静态站点生成（无服务端运行时开销，无动态数据库依赖）',
      '完全自包含的 MDX 内容集与本地高分辨率图片资产',
      'TypeScript 编译期严格类型校验，保障跨语言内容体系一致性',
      '原生 5 种语言（中、英、法、德、日）对照与稳定的 translationId 双向关联',
      '无 JavaScript 依赖即可完成全文阅读与目录平滑导轨',
    ],
    contactTitle: '公开档案与联络渠道',
    noContact: '暂未配置公开社交档案。',
  },
  'en': {
    badge: 'Engineering Practice · Knowledge Architecture',
    whoTitle: 'About the Author',
    whoText: 'A software engineer focused on system architecture, applied AI agents, and high-precision modern web systems.',
    focusTitle: 'Core Disciplines',
    focusItems: [
      { title: 'Software Engineering & Architecture', desc: 'Maintainability, modular evolution, interface contracts, and long-term stability.' },
      { title: 'AI, LLM & Agent Workflows', desc: 'Production deployment patterns, autonomous agents, tool orchestration, and eval frameworks.' },
      { title: 'Frontend & Runtime Performance', desc: 'Browser internals, static-by-default compilation, and ergonomic interface engineering.' },
      { title: 'Design Systems & UX', desc: 'Marrying editorial typographic rhythm with strict digital engineering specifications.' },
      { title: 'Postmortems & Technical Notes', desc: 'Real troubleshooting logs, architectural trade-offs, and empirical lessons learned.' },
    ],
    whyTitle: 'The Ten-Year Horizon',
    whyText: 'In an era of fleeting social feeds and ephemeral platforms, this site serves as a durable, self-hosted knowledge archive designed to remain legible and relevant over the next 5 to 10 years.',
    stackTitle: 'System Architecture Specification',
    stackText: 'Engineered for maximal longevity following the static-by-default doctrine:',
    stackItems: [
      'Astro static site generation (zero runtime servers, zero database dependencies)',
      'Self-contained MDX content collections with local high-fidelity assets',
      'Strict compile-time TypeScript type checking across all multilingual taxonomies',
      'Native five-language parity (zh-CN, en, fr, de, ja) bound via translationId',
      'Fully readable and navigable with zero JavaScript hydration overhead',
    ],
    contactTitle: 'Profiles & Dispatch Channels',
    noContact: 'No public profiles currently registered.',
  },
  'fr': {
    badge: 'Ingénierie & Architecture',
    whoTitle: "À propos de l'auteur",
    whoText: "Ingénieur logiciel spécialisé dans l'architecture de systèmes, les agents IA appliqués et l'ingénierie web moderne.",
    focusTitle: 'Domaines de recherche',
    focusItems: [
      { title: 'Génie logiciel & Architecture', desc: 'Conception durable, modularisation et robustesse à long terme.' },
      { title: 'IA, LLM & Agents autonomes', desc: 'Pipelines de production, agents autonomes et orchestration d’outils.' },
      { title: 'Frontend & Performance Web', desc: 'Moteurs de navigateurs, compilation statique et ergonomie.' },
      { title: 'Design Systems & UX', desc: 'Harmonie typographique éditoriale et rigueur d’ingénierie numérique.' },
      { title: 'Retours d’expérience & Postmortems', desc: 'Dépannage réel, compromis d’architecture et analyses d’incidents.' },
    ],
    whyTitle: 'Pourquoi ce système de connaissances',
    whyText: 'Un espace dédié à la capitalisation de savoirs techniques structurés, pensé pour rester lisible et pertinent sur un horizon de 5 à 10 ans.',
    stackTitle: 'Architecture du site',
    stackText: 'Conçu selon le principe du statique par défaut (Static by Default) pour une pérennité maximale :',
    stackItems: [
      'Génération statique Astro (zéro serveur dynamique, zéro dépendance SQL)',
      'Collections MDX auto-contenues avec ressources locales',
      'Typage TypeScript strict garantissant l’intégrité multilingue',
      'Support de 5 langues (zh-CN, en, fr, de, ja) synchronisées via translationId',
    ],
    contactTitle: 'Profils & Contact',
    noContact: 'Aucun profil public pour le moment.',
  },
  'de': {
    badge: 'Profil & Systemarchitektur',
    whoTitle: 'Über den Autor',
    whoText: 'Software-Ingenieur mit Fokus auf robuste Systemarchitektur, KI-Agentensysteme und modernes Web-Engineering.',
    focusTitle: 'Schwerpunktbereiche',
    focusItems: [
      { title: 'Software-Engineering & Architektur', desc: 'Nachhaltiges Systemdesign, Modularisierung und Ausfallsicherheit.' },
      { title: 'KI, LLM & Agenten-Workflows', desc: 'Autonome Agentensysteme, Tool-Calling und Praxiserfahrungen in der Produktion.' },
      { title: 'Frontend & Web-Performance', desc: 'Browser-Interna, statische Kompilierung und performante UIs.' },
      { title: 'Design-Systeme & UX', desc: 'Typografischer Rhythmus und digitale Ingenieurspräzision.' },
      { title: 'Notizen & Retrospektiven', desc: 'Detaillierte Fehlerdiagnosen, Kompromissabwägungen und Postmortems.' },
    ],
    whyTitle: 'Warum dieser Blog',
    whyText: 'Ein technischer Rückzugsort für langfristige Wissensakkumulation und strukturierte Dokumentation für die nächsten 5–10 Jahre.',
    stackTitle: 'Technologie-Stack & Spezifikation',
    stackText: 'Entwickelt für maximale Haltbarkeit nach dem Static-by-Default-Prinzip:',
    stackItems: [
      'Astro Static Site Generation (keine dynamische Datenbank, kein Server-Overhead)',
      'Eigenständige MDX-Sammlungen mit lokalen Medienressourcen',
      'Strikte TypeScript-Typisierung zur Absicherung aller Taxonomien',
      'Fünfsprachige native Lokalisierung (zh-CN, en, fr, de, ja) verknüpft über translationId',
    ],
    contactTitle: 'Profile & Kontakt',
    noContact: 'Derzeit keine externen Profile hinterlegt.',
  },
  'ja': {
    badge: '技術背景と本サイトについて',
    whoTitle: '著者について',
    whoText: '堅牢なシステム設計、AIエージェントの実装、モダンWeb技術に注力するソフトウェアエンジニア。',
    focusTitle: '主要な技術領域',
    focusItems: [
      { title: 'ソフトウェア工学とアーキテクチャ', desc: '持続可能なシステム設計、疎結合、コードの進化と実践的設計。' },
      { title: 'AI・LLM・自律型エージェント', desc: 'エージェントワークフロー、ツール呼び出し、実運用の知見。' },
      { title: 'フロントエンドとWeb技術', desc: 'モダンフレームワーク、ブラウザ内部動作、性能最適化。' },
      { title: 'デザインシステムとUX', desc: 'UIの単一情報源、インタラクションモデル、組版美学の融合。' },
      { title: '技術ノートと振り返り', desc: 'トラブルシューティング記録、ツール選定、プロジェクトの事後検証。' },
    ],
    whyTitle: 'この知識システムを構築する理由',
    whyText: '移り変わりの激しいIT業界において、断片的な情報発信ではなく、5〜10年先も参照できる体系的な知識と検証結果を蓄積するための技術拠点です。',
    stackTitle: '採用技術と設計思想',
    stackText: '超長期的な保守性とパフォーマンスを追求した「完全静的（Static by Default）」構成：',
    stackItems: [
      'Astroによる静的サイト生成（動的DBなし、ランタイムサーバー不要）',
      '自己完結型のMDXコンテンツコレクションとローカル画像管理',
      'TypeScriptによる厳格な型安全性と多言語データの整合性担保',
      '安定したtranslationIdによる5言語ネイティブ対応（zh-CN, en, fr, de, ja）',
    ],
    contactTitle: 'リンクと連絡先',
    noContact: '現在公開中の外部アカウントはありません。',
  },
};

const copy = aboutCopy[locale] || aboutCopy['zh-CN'];
---

<BaseLayout
  locale={locale}
  title={t.aboutTitle}
  description={siteConfig.siteDescription[locale]}
  canonicalUrl={canonicalUrl}
  alternateHreflangs={alternateHreflangs}
  translationLinks={translationLinks}
>
  <div class="mx-auto max-w-5xl px-4 sm:px-8 lg:px-12 py-10 sm:py-16 space-y-20">
    <!-- Header Masthead -->
    <header class="border-b border-[#1b1a18] pb-10 space-y-4">
      <div class="flex items-center gap-3 text-xs font-mono uppercase tracking-widest text-[#88847b]">
        <span>SPECIFICATION</span>
        <span>·</span>
        <span>{copy.badge}</span>
      </div>
      <h1 class="font-serif text-4xl sm:text-6xl font-bold tracking-tight text-[#1b1a18]">
        {t.aboutTitle}
      </h1>
      <p class="font-serif text-xl text-[#57544e] max-w-2xl leading-relaxed">
        {siteConfig.siteDescription[locale]}
      </p>
    </header>

    <!-- 01. Author Profile -->
    <section class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 items-start border-b border-[#e6e2d8] pb-16">
      <div class="md:col-span-4 space-y-4">
        <div class="aspect-square overflow-hidden border border-[#e6e2d8] bg-[#e8e4db] max-w-[220px]">
          <img
            src={siteConfig.author.avatar}
            alt={siteConfig.author.name}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover"
          />
        </div>
        <div class="space-y-1 font-mono text-xs">
          <div class="font-bold text-[#1b1a18] font-serif text-base">{siteConfig.author.name}</div>
          <div class="text-[#88847b]">Software & Systems Engineer</div>
          <div class="text-[10px] text-[#a5a095]">LOC: UTC+8 / ASIA</div>
        </div>
      </div>

      <div class="md:col-span-8 space-y-6">
        <div class="text-xs font-mono uppercase tracking-widest text-[#88847b]">
          01 / IDENTITY
        </div>
        <h2 class="font-serif text-3xl font-bold text-[#1b1a18]">
          {copy.whoTitle}
        </h2>
        <div class="font-serif text-lg text-[#1b1a18] leading-relaxed space-y-4">
          <p>{copy.whoText}</p>
          <p class="text-sm text-[#57544e] leading-relaxed font-sans">{siteConfig.author.bio[locale]}</p>
        </div>
      </div>
    </section>

    <!-- 02. Core Focus Areas -->
    <section class="space-y-8 border-b border-[#e6e2d8] pb-16">
      <div class="flex items-baseline justify-between">
        <div class="space-y-1">
          <div class="text-xs font-mono uppercase tracking-widest text-[#88847b]">
            02 / DISCIPLINES
          </div>
          <h2 class="font-serif text-3xl font-bold text-[#1b1a18]">
            {copy.focusTitle}
          </h2>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-[#e6e2d8] border border-[#e6e2d8]">
        {copy.focusItems.map((item, idx) => (
          <div class="bg-[#f9f8f5] p-6 sm:p-8 space-y-2">
            <div class="text-xs font-mono text-[#88847b]">
              SPEC 0{idx + 1}
            </div>
            <h3 class="font-serif text-xl font-bold text-[#1b1a18]">
              {item.title}
            </h3>
            <p class="font-serif text-sm text-[#57544e] leading-relaxed">
              {item.desc}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- 03. The Ten-Year Horizon -->
    <section class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start border-b border-[#e6e2d8] pb-16">
      <div class="md:col-span-4 text-xs font-mono uppercase tracking-widest text-[#88847b]">
        03 / TEN-YEAR HORIZON
      </div>
      <div class="md:col-span-8 space-y-4">
        <h2 class="font-serif text-3xl font-bold text-[#1b1a18]">
          {copy.whyTitle}
        </h2>
        <p class="font-serif text-lg text-[#57544e] leading-relaxed">
          {copy.whyText}
        </p>
      </div>
    </section>

    <!-- 04. Technical Architecture Blueprint -->
    <section class="space-y-6 border-b border-[#e6e2d8] pb-16">
      <div class="text-xs font-mono uppercase tracking-widest text-[#88847b]">
        04 / SYSTEM ARCHITECTURE
      </div>
      <h2 class="font-serif text-3xl font-bold text-[#1b1a18]">
        {copy.stackTitle}
      </h2>
      <p class="font-serif text-base text-[#57544e]">
        {copy.stackText}
      </p>

      <div class="border border-[#e6e2d8] bg-[#f2efe9] p-6 sm:p-8 font-mono text-xs space-y-3">
        {copy.stackItems.map((item, idx) => (
          <div class="flex items-baseline gap-3 text-[#1b1a18]">
            <span class="text-[#88847b] font-bold">[{idx + 1}]</span>
            <span class="leading-relaxed">{item}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- 05. Dispatch & Public Profiles -->
    <section class="space-y-6">
      <div class="text-xs font-mono uppercase tracking-widest text-[#88847b]">
        05 / CHANNELS
      </div>
      <h2 class="font-serif text-3xl font-bold text-[#1b1a18]">
        {copy.contactTitle}
      </h2>

      <div class="flex flex-wrap gap-4 pt-2">
        {!siteConfig.author.social.email && !siteConfig.author.social.github && !siteConfig.author.social.x && !siteConfig.author.social.linkedin && (
          <p class="text-xs font-mono text-[#88847b] border border-[#e6e2d8] p-4 bg-[#f2efe9] w-full max-w-md">
            {copy.noContact}
          </p>
        )}
        {siteConfig.author.social.email && (
          <a
            href={siteConfig.author.social.email}
            class="group inline-flex items-center gap-2 px-5 py-3 border border-[#1b1a18] bg-[#1b1a18] text-[#f9f8f5] hover:bg-transparent hover:text-[#1b1a18] text-xs font-mono uppercase tracking-wider transition-colors"
          >
            <span>Email Inquiries</span>
            <ArrowUpRight className="h-3.5 w-3.5" />
          </a>
        )}
        {siteConfig.author.social.github && (
          <a
            href={siteConfig.author.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-2 px-5 py-3 border border-[#e6e2d8] bg-[#ffffff] hover:border-[#1b1a18] text-[#1b1a18] text-xs font-mono uppercase tracking-wider transition-colors"
          >
            <span>GitHub Architecture</span>
            <ArrowUpRight className="h-3.5 w-3.5" />
          </a>
        )}
        {siteConfig.author.social.x && (
          <a
            href={siteConfig.author.social.x}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-2 px-5 py-3 border border-[#e6e2d8] bg-[#ffffff] hover:border-[#1b1a18] text-[#1b1a18] text-xs font-mono uppercase tracking-wider transition-colors"
          >
            <span>X (Twitter)</span>
            <ArrowUpRight className="h-3.5 w-3.5" />
          </a>
        )}
      </div>
    </section>
  </div>
</BaseLayout>
