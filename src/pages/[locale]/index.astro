---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ArrowUpRight } from 'lucide-react';
import { siteConfig } from '../../config/site.config';
import { getTagDisplayName } from '../../config/tags';
import {
  getFeaturedArticles,
  getLatestArticles,
  getArticlesByCategory,
  validateContentIntegrity,
} from '../../lib/content';
import { calculateReadingMetrics } from '../../lib/readingTime';
import { uiTranslations } from '../../i18n/translations';
import type { SupportedLocale } from '../../types/content';

export function getStaticPaths() {
  return siteConfig.supportedLocales.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: SupportedLocale };
const t = uiTranslations[locale];

const allPosts = await getCollection('blog');
validateContentIntegrity(allPosts);

const featuredArticles = getFeaturedArticles(allPosts, locale, 4);
const latestArticles = getLatestArticles(allPosts, locale, 10);

// Establish explicit editorial content hierarchy:
// 1. Lead Story (largest, major visual anchor)
const leadStory = featuredArticles[0] || latestArticles[0];

// 2. Secondary Stories (distinct scales & treatments, avoiding identical cards)
const secondaryCandidates = (featuredArticles.length > 1
  ? featuredArticles.slice(1)
  : latestArticles.filter((a) => a.data.slug !== leadStory?.data.slug)
).slice(0, 2);

// 3. Journal Catalog: chronological index excluding lead & secondaries
const featuredSlugs = new Set([
  leadStory?.data.slug,
  ...secondaryCandidates.map((a) => a.data.slug),
].filter(Boolean));

const journalArticles = latestArticles.filter((a) => !featuredSlugs.has(a.data.slug));

const alternateHreflangs: Record<SupportedLocale, string> = {
  'zh-CN': `${siteConfig.siteUrl}/zh-CN`,
  'en': `${siteConfig.siteUrl}/en`,
  'fr': `${siteConfig.siteUrl}/fr`,
  'de': `${siteConfig.siteUrl}/de`,
  'ja': `${siteConfig.siteUrl}/ja`,
};

const translationLinks: Record<SupportedLocale, { url: string; available: boolean }> = {
  'zh-CN': { url: '/zh-CN', available: true },
  'en': { url: '/en', available: true },
  'fr': { url: '/fr', available: true },
  'de': { url: '/de', available: true },
  'ja': { url: '/ja', available: true },
};

function getCoverSrc(cover: any): string {
  if (!cover) return '';
  return typeof cover === 'string' ? cover : cover.src;
}

const heroStatements: Record<SupportedLocale, { quote: string; sub: string }> = {
  'zh-CN': {
    quote: '记录我构建的软件、研究的系统架构，以及在工程实践中反复验证的技术思考。',
    sub: 'Rocky 的个人技术期刊 · 软件工程 · AI 智能体 · 系统架构 · 前端与交互设计',
  },
  'en': {
    quote: 'I write about the software I build, the systems I study, and the ideas I keep returning to.',
    sub: 'Personal technical publication by Rocky · Software Engineering · AI & Agents · Systems · Design',
  },
  'fr': {
    quote: "Notes sur les logiciels que je conçois, les systèmes que j'étudie et les principes d'ingénierie durables.",
    sub: "Publication technique personnelle de Rocky · Génie Logiciel · IA & Agents · Systèmes · Design",
  },
  'de': {
    quote: 'Aufzeichnungen über gebaute Software, untersuchte Systeme und beständige Ideen des Software-Engineerings.',
    sub: 'Persönliche Fachpublikation von Rocky · Softwaretechnik · KI-Agenten · Systeme · Design',
  },
  'ja': {
    quote: '構築するソフトウェア、探求するシステム構造、そして繰り返し立ち返る技術的原則についての記録。',
    sub: 'Rocky の個人技術出版 · ソフトウェア工学 · AIエージェント · システム設計 · UX',
  },
};

const currentHero = heroStatements[locale] || heroStatements['en'];

const categorySubtopicsList: Record<string, Record<SupportedLocale, string[]>> = {
  engineering: {
    'zh-CN': ['软件系统架构', '分布式设计', '稳定性与容灾'],
    'en': ['Software architecture', 'Systems', 'Reliability'],
    'fr': ['Architecture logicielle', 'Systèmes distribués', 'Fiabilité'],
    'de': ['Softwarearchitektur', 'Verteilte Systeme', 'Zuverlässigkeit'],
    'ja': ['ソフトウェアアーキテクチャ', '分散システム', '信頼性工学'],
  },
  ai: {
    'zh-CN': ['大语言模型 (LLM)', '自律智能体 (Agents)', 'AI 生产落地'],
    'en': ['LLM', 'Agents', 'AI systems'],
    'fr': ['LLM', 'Agents autonomes', 'Systèmes IA'],
    'de': ['LLM', 'Agenten', 'KI-Systeme'],
    'ja': ['大規模言語モデル (LLM)', '自律エージェント', 'AIシステム構築'],
  },
  frontend: {
    'zh-CN': ['React / Web', '编译与渲染', '性能工程'],
    'en': ['React', 'Web', 'Performance'],
    'fr': ['React', 'Web', 'Performance'],
    'de': ['React', 'Web', 'Performance'],
    'ja': ['React', 'Web', 'パフォーマンス'],
  },
  'design-ux': {
    'zh-CN': ['设计系统', '出版排版', '交互与可用性'],
    'en': ['Design systems', 'Typography', 'Interaction & UX'],
    'fr': ['Design systems', 'Typographie', 'Interaction & UX'],
    'de': ['Design-Systeme', 'Typografie', 'Interaktion & UX'],
    'ja': ['デザインシステム', '組版美学', 'UXとアクセシビリティ'],
  },
  notes: {
    'zh-CN': ['架构复盘', '疑难排错', '实验记录'],
    'en': ['Postmortems', 'Troubleshooting', 'Experiments'],
    'fr': ['Retours d’expérience', 'Dépannage', 'Notes de lab'],
    'de': ['Postmortems', 'Fehlerdiagnose', 'Experimente'],
    'ja': ['事後検証 (Postmortem)', 'トラブルシューティング', '実験ノート'],
  },
};
---

<BaseLayout
  locale={locale}
  canonicalUrl={`${siteConfig.siteUrl}/${locale}`}
  alternateHreflangs={alternateHreflangs}
  translationLinks={translationLinks}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-8 lg:px-12 py-8 sm:py-12 space-y-20 sm:space-y-28">
    
    <!-- 1. EDITORIAL MASTHEAD STRIP (Restrained, high-stature brand header) -->
    <section class="border-b border-[#1b1a18] pb-6 sm:pb-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12 items-baseline">
        <!-- Left: Brand Identity (5 cols) -->
        <div class="lg:col-span-5 space-y-1.5">
          <div class="flex items-baseline gap-3">
            <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-[#1b1a18]">
              ROCKY
            </h1>
            <span class="text-xs font-mono text-[#88847b] uppercase tracking-widest">
              Journal
            </span>
          </div>
          <p class="text-xs font-mono tracking-wider text-[#57544e] uppercase">
            Software · AI · Systems · Design
          </p>
        </div>

        <!-- Right: Author Statement of Direction (7 cols) -->
        <div class="lg:col-span-7 flex flex-col justify-end space-y-2 lg:text-right">
          <p class="font-serif text-base sm:text-lg text-[#1b1a18] font-normal leading-snug">
            “{currentHero.quote}”
          </p>
          <p class="text-xs font-mono text-[#88847b]">
            {currentHero.sub}
          </p>
        </div>
      </div>
    </section>

    <!-- 2. LEAD STORY (CONTENT IS THE HERO: Dominant scale, dramatic typography, large editorial imagery) -->
    {leadStory && (
      <section class="space-y-8">
        <!-- Editorial Section Eyebrow -->
        <div class="flex items-baseline justify-between border-b border-[#e6e2d8] pb-2 text-xs font-mono text-[#88847b]">
          <div class="flex items-center gap-3">
            <span class="font-bold text-[#1b1a18] uppercase tracking-widest">
              LEAD STORY
            </span>
            <span>/</span>
            <span class="uppercase tracking-wider text-[#57544e]">
              {siteConfig.categories.find((c) => c.id === leadStory.data.category)?.name[locale] || leadStory.data.category}
            </span>
          </div>
          <div class="flex items-center gap-3">
            <time datetime={leadStory.data.pubDate}>{leadStory.data.pubDate}</time>
            <span>·</span>
            <span>{t.readingTimeFormat(calculateReadingMetrics(leadStory.body || '', locale).minutes)}</span>
          </div>
        </div>

        <!-- Primary Article Composition -->
        <article class="group space-y-8">
          <!-- Super-Scale Article Title -->
          <h2 class="font-serif text-3xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold text-[#1b1a18] leading-[1.06] tracking-tight group-hover:text-[#1e3a5f] transition-colors max-w-5xl">
            <a href={`/${locale}/blog/${leadStory.data.slug}`}>
              {leadStory.data.title}
            </a>
          </h2>

          <!-- Asymmetric Lead Layout: Text Column + Grand Image Plate -->
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-start pt-2">
            <!-- Left Narrative Column (5 cols) -->
            <div class="lg:col-span-5 space-y-6 flex flex-col justify-between">
              <p class="font-serif text-lg sm:text-xl text-[#57544e] leading-relaxed">
                {leadStory.data.description}
              </p>

              <div class="space-y-4 pt-4 border-t border-[#e6e2d8]">
                <div class="flex flex-wrap gap-x-3 gap-y-1 text-xs font-mono text-[#88847b]">
                  {leadStory.data.tags.slice(0, 4).map((tag: string) => (
                    <a href={`/${locale}/tag/${tag}`} class="hover:text-[#1b1a18]">
                      #{getTagDisplayName(tag, locale)}
                    </a>
                  ))}
                </div>

                <div>
                  <a
                    href={`/${locale}/blog/${leadStory.data.slug}`}
                    class="inline-flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-widest text-[#1b1a18] hover:underline underline-offset-6 group"
                  >
                    <span>Read Full Essay</span>
                    <ArrowUpRight className="h-4 w-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
                  </a>
                </div>
              </div>
            </div>

            <!-- Right Visual Plate (7 cols) - Dramatic Wide Image Crop -->
            <div class="lg:col-span-7">
              {getCoverSrc(leadStory.data.cover) ? (
                <div class="space-y-2">
                  <a
                    href={`/${locale}/blog/${leadStory.data.slug}`}
                    class="block overflow-hidden border border-[#e6e2d8] bg-[#e8e4db] aspect-[16/10] sm:aspect-[16/9]"
                  >
                    <img
                      src={getCoverSrc(leadStory.data.cover)}
                      alt={leadStory.data.coverAlt || leadStory.data.title}
                      loading="eager"
                      fetchpriority="high"
                      decoding="async"
                      class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.02]"
                    />
                  </a>
                  <div class="flex items-baseline justify-between text-[10px] font-mono text-[#88847b]">
                    <span>COVER PLATE · {leadStory.data.slug}</span>
                    <span>{leadStory.data.coverAlt || 'Editorial Visual Plate'}</span>
                  </div>
                </div>
              ) : (
                <div class="border border-[#e6e2d8] bg-[#f5f3ec] p-8 sm:p-12 space-y-4 font-serif">
                  <div class="text-xs font-mono uppercase tracking-widest text-[#88847b]">
                    Editorial Thesis
                  </div>
                  <blockquote class="text-xl sm:text-2xl text-[#1b1a18] leading-relaxed italic border-l-2 border-[#1b1a18] pl-4">
                    “{leadStory.data.description}”
                  </blockquote>
                </div>
              )}
            </div>
          </div>
        </article>
      </section>
    )}

    <!-- 3. SECONDARY STORIES (Varied scale, broken uniformity, mixed visual density) -->
    {secondaryCandidates.length > 0 && (
      <section class="border-t border-[#1b1a18] pt-12 space-y-12">
        <div class="flex items-baseline justify-between border-b border-[#e6e2d8] pb-2 text-xs font-mono text-[#88847b]">
          <span class="font-bold text-[#1b1a18] uppercase tracking-widest">
            SECONDARY ESSAYS & DISPATCHES
          </span>
          <span class="text-[11px] uppercase tracking-wider">
            Curated Technical Investigations
          </span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
          <!-- Story 1: Horizontal Editorial Focus (7 cols) -->
          {secondaryCandidates[0] && (
            <article class="lg:col-span-7 group space-y-5">
              {getCoverSrc(secondaryCandidates[0].data.cover) ? (
                <a
                  href={`/${locale}/blog/${secondaryCandidates[0].data.slug}`}
                  class="block aspect-[16/9] overflow-hidden border border-[#e6e2d8] bg-[#e8e4db]"
                >
                  <img
                    src={getCoverSrc(secondaryCandidates[0].data.cover)}
                    alt={secondaryCandidates[0].data.coverAlt || secondaryCandidates[0].data.title}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
                  />
                </a>
              ) : null}

              <div class="flex items-center gap-3 text-xs font-mono text-[#88847b]">
                <span class="font-semibold uppercase text-[#1b1a18]">
                  01 / {siteConfig.categories.find((c) => c.id === secondaryCandidates[0].data.category)?.name[locale] || secondaryCandidates[0].data.category}
                </span>
                <span>·</span>
                <span>{secondaryCandidates[0].data.pubDate}</span>
                <span>·</span>
                <span>{t.readingTimeFormat(calculateReadingMetrics(secondaryCandidates[0].body || '', locale).minutes)}</span>
              </div>

              <h3 class="font-serif text-2xl sm:text-3xl font-bold text-[#1b1a18] leading-tight group-hover:text-[#1e3a5f] transition-colors">
                <a href={`/${locale}/blog/${secondaryCandidates[0].data.slug}`}>
                  {secondaryCandidates[0].data.title}
                </a>
              </h3>

              <p class="font-serif text-base text-[#57544e] leading-relaxed line-clamp-3">
                {secondaryCandidates[0].data.description}
              </p>

              <div>
                <a
                  href={`/${locale}/blog/${secondaryCandidates[0].data.slug}`}
                  class="inline-flex items-center gap-1.5 text-xs font-mono font-medium uppercase tracking-wider text-[#1b1a18] hover:underline underline-offset-4"
                >
                  <span>Explore Analysis</span>
                  <ArrowUpRight className="h-3.5 w-3.5" />
                </a>
              </div>
            </article>
          )}

          <!-- Story 2: Text-Heavy Architectural Reflection (5 cols) -->
          {secondaryCandidates[1] && (
            <article class="lg:col-span-5 group space-y-6 lg:border-l lg:border-[#e6e2d8] lg:pl-10">
              <div class="flex items-center gap-3 text-xs font-mono text-[#88847b]">
                <span class="font-semibold uppercase text-[#1b1a18]">
                  02 / {siteConfig.categories.find((c) => c.id === secondaryCandidates[1].data.category)?.name[locale] || secondaryCandidates[1].data.category}
                </span>
                <span>·</span>
                <span>{secondaryCandidates[1].data.pubDate}</span>
              </div>

              <div class="space-y-3">
                <h3 class="font-serif text-2xl sm:text-3xl font-bold text-[#1b1a18] leading-tight group-hover:text-[#1e3a5f] transition-colors">
                  <a href={`/${locale}/blog/${secondaryCandidates[1].data.slug}`}>
                    {secondaryCandidates[1].data.title}
                  </a>
                </h3>

                <div class="py-3 border-y border-[#ece8de]">
                  <p class="font-serif text-base text-[#1b1a18] italic leading-relaxed">
                    “{secondaryCandidates[1].data.description}”
                  </p>
                </div>
              </div>

              <div class="space-y-3 text-xs font-mono text-[#88847b]">
                <div class="flex flex-wrap gap-2">
                  {secondaryCandidates[1].data.tags.slice(0, 3).map((tag: string) => (
                    <span>#{getTagDisplayName(tag, locale)}</span>
                  ))}
                </div>
                <div>
                  <a
                    href={`/${locale}/blog/${secondaryCandidates[1].data.slug}`}
                    class="inline-flex items-center gap-1.5 font-medium uppercase tracking-wider text-[#1b1a18] hover:underline underline-offset-4"
                  >
                    <span>Read Note</span>
                    <ArrowUpRight className="h-3.5 w-3.5" />
                  </a>
                </div>
              </div>
            </article>
          )}
        </div>
      </section>
    )}

    <!-- 4. LATEST JOURNAL (Editorial Index: Typographic, numbered, hairline rules, no card containers) -->
    <section class="border-t border-[#1b1a18] pt-12 space-y-8">
      <div class="flex items-baseline justify-between border-b border-[#e6e2d8] pb-3">
        <div class="flex items-baseline gap-3">
          <span class="text-xs font-mono font-bold uppercase tracking-widest text-[#1b1a18]">
            CHRONOLOGICAL JOURNAL
          </span>
          <span class="text-[#cfc9be]">/</span>
          <h2 class="font-serif text-xl sm:text-2xl font-bold tracking-tight text-[#1b1a18]">
            {t.latestArticlesTitle}
          </h2>
        </div>
        <a
          href={`/${locale}/archive`}
          class="group inline-flex items-center gap-1.5 text-xs font-mono uppercase tracking-wider text-[#57544e] hover:text-[#1b1a18]"
        >
          <span>{t.navArchive}</span>
          <ArrowUpRight className="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
        </a>
      </div>

      <!-- Clean Typographic List -->
      <div class="divide-y divide-[#e6e2d8]">
        {(journalArticles.length > 0 ? journalArticles : latestArticles).map((article, idx) => {
          const readingMin = calculateReadingMetrics(article.body || '', locale).minutes;
          return (
            <article class="group py-6 grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 items-baseline hover:bg-[#f3f0e8]/50 px-2 -mx-2 transition-colors">
              <!-- Meta Column: Index Number, Date & Category (3 cols) -->
              <div class="md:col-span-3 flex md:flex-col items-baseline md:items-start gap-3 md:gap-1 font-mono text-xs">
                <div class="flex items-baseline gap-2">
                  <span class="text-[11px] font-bold text-[#1b1a18]">{String(idx + 1).padStart(2, '0')}</span>
                  <span class="text-[#1b1a18] font-medium">{article.data.pubDate}</span>
                </div>
                <div class="text-[11px] uppercase tracking-wider text-[#88847b]">
                  {siteConfig.categories.find((c) => c.id === article.data.category)?.name[locale] || article.data.category}
                </div>
              </div>

              <!-- Main Story Content (7 cols) -->
              <div class="md:col-span-7 space-y-1.5">
                <h3 class="font-serif text-xl sm:text-2xl font-bold text-[#1b1a18] leading-snug group-hover:text-[#1e3a5f] group-hover:translate-x-0.5 transition-all">
                  <a href={`/${locale}/blog/${article.data.slug}`}>
                    {article.data.title}
                  </a>
                </h3>
                <p class="font-serif text-sm text-[#57544e] leading-relaxed line-clamp-2">
                  {article.data.description}
                </p>
                <div class="flex flex-wrap gap-x-3 gap-y-1 pt-1 text-[11px] font-mono text-[#88847b]">
                  {article.data.tags.slice(0, 3).map((tag: string) => (
                    <a href={`/${locale}/tag/${tag}`} class="hover:text-[#1b1a18]">
                      #{getTagDisplayName(tag, locale)}
                    </a>
                  ))}
                </div>
              </div>

              <!-- Reading Action (2 cols) -->
              <div class="hidden md:flex md:col-span-2 flex-col items-end text-xs font-mono text-[#88847b]">
                <div>{t.readingTimeFormat(readingMin)}</div>
                <a
                  href={`/${locale}/blog/${article.data.slug}`}
                  class="inline-flex items-center gap-1 text-xs uppercase tracking-wider text-[#1b1a18] group-hover:underline underline-offset-4 pt-2"
                >
                  <span>Read</span>
                  <ArrowUpRight className="h-3 w-3" />
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- 5. TOPIC INDEX (Publication Taxonomy: Editorial disciplines, structured knowledge overview) -->
    <section class="border-t border-[#1b1a18] pt-12 space-y-8">
      <div class="flex items-baseline justify-between border-b border-[#e6e2d8] pb-3">
        <div class="flex items-baseline gap-3">
          <span class="text-xs font-mono font-bold uppercase tracking-widest text-[#1b1a18]">
            TOPIC TAXONOMY
          </span>
          <span class="text-[#cfc9be]">/</span>
          <h2 class="font-serif text-xl sm:text-2xl font-bold tracking-tight text-[#1b1a18]">
            {t.categoriesTitle}
          </h2>
        </div>
        <span class="text-xs font-mono text-[#88847b]">
          5 Disciplines
        </span>
      </div>

      <!-- Publication Taxonomy Disciplines Grid -->
      <div class="grid grid-cols-1 md:grid-cols-5 divide-y md:divide-y-0 md:divide-x divide-[#e6e2d8] border-y border-[#e6e2d8]">
        {siteConfig.categories.map((cat, idx) => {
          const count = getArticlesByCategory(allPosts, locale, cat.id).length;
          const subtopics = categorySubtopicsList[cat.id]?.[locale] || [];

          return (
            <a
              href={`/${locale}/category/${cat.id}`}
              class="group bg-transparent hover:bg-[#f3f0e8]/60 p-6 lg:p-7 space-y-5 transition-colors block text-left"
            >
              <div class="flex items-baseline justify-between text-xs font-mono text-[#88847b]">
                <span class="font-bold text-[#1b1a18]">{String(idx + 1).padStart(2, '0')}</span>
                <span class="text-[10px]">{count} {count === 1 ? 'PIECE' : 'PIECES'}</span>
              </div>

              <div>
                <h3 class="font-serif text-lg sm:text-xl font-bold tracking-tight text-[#1b1a18] group-hover:text-[#1e3a5f] transition-colors uppercase">
                  {cat.name[locale]}
                </h3>
              </div>

              <ul class="space-y-1.5 text-xs font-mono text-[#57544e]">
                {subtopics.map((item) => (
                  <li class="flex items-baseline gap-2">
                    <span class="text-[#cfc9be]">·</span>
                    <span class="leading-relaxed">{item}</span>
                  </li>
                ))}
              </ul>

              <div class="pt-2 text-[11px] font-mono text-[#88847b] group-hover:text-[#1b1a18] group-hover:underline underline-offset-4 flex items-center gap-1">
                <span>View index</span>
                <span>→</span>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- 6. KNOWLEDGE TAGS DISCOVERY -->
    <section class="border-t border-[#e6e2d8] pt-10 space-y-4">
      <div class="flex items-baseline justify-between">
        <div class="flex items-baseline gap-3">
          <span class="text-xs font-mono font-bold uppercase tracking-widest text-[#1b1a18]">
            INDEX KEYWORDS
          </span>
          <span class="text-[#cfc9be]">/</span>
          <h3 class="font-serif text-lg font-bold tracking-tight text-[#1b1a18]">
            {t.tagsLabel}
          </h3>
        </div>
        <a
          href={`/${locale}/tags`}
          class="text-xs font-mono uppercase tracking-wider text-[#57544e] hover:text-[#1b1a18]"
        >
          {t.allTags} →
        </a>
      </div>

      <div class="flex flex-wrap gap-x-4 gap-y-2 text-xs font-mono text-[#57544e]">
        {['architecture', 'react', 'typescript', 'astro', 'ai', 'llm', 'agents', 'web-performance', 'design-systems', 'github', 'static-web'].map((tagId) => (
          <a
            href={`/${locale}/tag/${tagId}`}
            class="hover:text-[#1b1a18] transition-colors"
          >
            #{getTagDisplayName(tagId, locale)}
          </a>
        ))}
      </div>
    </section>

    <!-- 7. EDITORIAL STATEMENT OF PRACTICE (Colophon transition) -->
    <section class="border-t border-[#1b1a18] pt-12 pb-6">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
        <div class="md:col-span-4 text-xs font-mono uppercase tracking-widest text-[#88847b]">
          STATEMENT OF PRACTICE
        </div>
        <div class="md:col-span-8 space-y-4">
          <p class="font-serif text-lg sm:text-xl text-[#1b1a18] leading-relaxed">
            {siteConfig.author.bio[locale]}
          </p>
          <div class="pt-2 flex items-center gap-6 text-xs font-mono">
            <a
              href={`/${locale}/about`}
              class="font-semibold text-[#1b1a18] hover:underline underline-offset-4 flex items-center gap-1"
            >
              <span>About Rocky's Practice</span>
              <ArrowUpRight className="h-3.5 w-3.5" />
            </a>
            <a
              href={`/${locale}/archive`}
              class="text-[#57544e] hover:text-[#1b1a18] hover:underline underline-offset-4"
            >
              Full Archive Timeline →
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
