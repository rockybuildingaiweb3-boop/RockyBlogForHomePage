---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { siteConfig } from '../../../config/site.config';
import { getArchiveByYear } from '../../../lib/content';
import { calculateReadingMetrics } from '../../../lib/readingTime';
import { uiTranslations } from '../../../i18n/translations';
import type { SupportedLocale } from '../../../types/content';

export function getStaticPaths() {
  return siteConfig.supportedLocales.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: SupportedLocale };
const t = uiTranslations[locale];

const allPosts = await getCollection('blog');
const archiveMap = getArchiveByYear(allPosts, locale);
const years = Array.from(archiveMap.keys()).sort((a, b) => b - a);

const canonicalUrl = `${siteConfig.siteUrl}/${locale}/archive`;

const alternateHreflangs: Record<SupportedLocale, string> = {
  'zh-CN': `${siteConfig.siteUrl}/zh-CN/archive`,
  'en': `${siteConfig.siteUrl}/en/archive`,
  'fr': `${siteConfig.siteUrl}/fr/archive`,
  'de': `${siteConfig.siteUrl}/de/archive`,
  'ja': `${siteConfig.siteUrl}/ja/archive`,
};

const translationLinks: Record<SupportedLocale, { url: string; available: boolean }> = {
  'zh-CN': { url: '/zh-CN/archive', available: true },
  'en': { url: '/en/archive', available: true },
  'fr': { url: '/fr/archive', available: true },
  'de': { url: '/de/archive', available: true },
  'ja': { url: '/ja/archive', available: true },
};
---

<BaseLayout
  locale={locale}
  title={t.archiveTitle}
  description={t.archiveSubtitle}
  canonicalUrl={canonicalUrl}
  alternateHreflangs={alternateHreflangs}
  translationLinks={translationLinks}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-8 lg:px-12 py-10 sm:py-16 space-y-16">
    <!-- Archive Masthead -->
    <header class="border-b border-[#1b1a18] pb-8 space-y-4">
      <div class="flex items-center gap-3 text-xs font-mono uppercase tracking-widest text-[#88847b]">
        <span>CHRONOLOGICAL REGISTRY</span>
        <span>·</span>
        <span>{allPosts.filter(p => !p.data.draft && p.data.lang === locale).length} WRITINGS</span>
      </div>
      <h1 class="font-serif text-4xl sm:text-6xl font-bold tracking-tight text-[#1b1a18]">
        {t.archiveTitle}
      </h1>
      <p class="font-serif text-lg text-[#57544e] max-w-2xl leading-relaxed">
        {t.archiveSubtitle}
      </p>
    </header>

    {years.length === 0 ? (
      <div class="py-20 text-center text-[#88847b] font-serif text-lg">
        {t.noArticlesFound}
      </div>
    ) : (
      <div class="space-y-16">
        {years.map((year) => {
          const articles = archiveMap.get(year) || [];
          return (
            <section class="space-y-6">
              <div class="flex items-baseline justify-between border-b border-[#1b1a18] pb-2">
                <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#1b1a18]">
                  {year}
                </h2>
                <span class="text-xs font-mono text-[#88847b]">
                  {articles.length} {articles.length === 1 ? 'ENTRY' : 'ENTRIES'}
                </span>
              </div>

              <div class="divide-y divide-[#e6e2d8]">
                {articles.map((article) => {
                  const readingMin = calculateReadingMetrics(article.body || '', locale).minutes;
                  return (
                    <article class="group py-5 grid grid-cols-1 md:grid-cols-12 gap-4 items-baseline hover:bg-[#f3f0e8]/50 px-2 -mx-2 transition-colors">
                      <div class="md:col-span-3 space-y-0.5 font-mono text-xs">
                        <div class="text-[#1b1a18]">{article.data.pubDate}</div>
                        <div class="text-[11px] uppercase tracking-wider text-[#88847b]">
                          {siteConfig.categories.find((c) => c.id === article.data.category)?.name[locale] || article.data.category}
                        </div>
                      </div>

                      <div class="md:col-span-7">
                        <h3 class="font-serif text-lg sm:text-xl font-bold text-[#1b1a18] group-hover:text-[#1e3a5f] transition-colors leading-snug">
                          <a href={`/${locale}/blog/${article.data.slug}`}>
                            {article.data.title}
                          </a>
                        </h3>
                      </div>

                      <div class="hidden md:flex md:col-span-2 justify-end text-xs font-mono text-[#88847b]">
                        <span>{t.readingTimeFormat(readingMin)}</span>
                      </div>
                    </article>
                  );
                })}
              </div>
            </section>
          );
        })}
      </div>
    )}
  </div>
</BaseLayout>
