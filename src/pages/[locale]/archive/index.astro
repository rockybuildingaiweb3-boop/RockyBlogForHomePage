---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { Calendar } from 'lucide-react';
import { siteConfig } from '../../../config/site.config';
import { getArchiveByYear } from '../../../lib/content';
import { calculateReadingMetrics } from '../../../lib/readingTime';
import { uiTranslations } from '../../../i18n/translations';
import type { SupportedLocale } from '../../../types/content';

export function getStaticPaths() {
  return siteConfig.supportedLocales.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: SupportedLocale };
const t = uiTranslations[locale];

const allPosts = await getCollection('blog');
const archiveMap = getArchiveByYear(allPosts, locale);
const years = Array.from(archiveMap.keys()).sort((a, b) => b - a);

const canonicalUrl = `${siteConfig.siteUrl}/${locale}/archive`;

const alternateHreflangs: Record<SupportedLocale, string> = {
  'zh-CN': `${siteConfig.siteUrl}/zh-CN/archive`,
  'en': `${siteConfig.siteUrl}/en/archive`,
  'fr': `${siteConfig.siteUrl}/fr/archive`,
  'de': `${siteConfig.siteUrl}/de/archive`,
  'ja': `${siteConfig.siteUrl}/ja/archive`,
};

const translationLinks: Record<SupportedLocale, { url: string; available: boolean }> = {
  'zh-CN': { url: '/zh-CN/archive', available: true },
  'en': { url: '/en/archive', available: true },
  'fr': { url: '/fr/archive', available: true },
  'de': { url: '/de/archive', available: true },
  'ja': { url: '/ja/archive', available: true },
};
---

<BaseLayout
  locale={locale}
  title={t.archiveTitle}
  description={t.archiveSubtitle}
  canonicalUrl={canonicalUrl}
  alternateHreflangs={alternateHreflangs}
  translationLinks={translationLinks}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-8 lg:px-12 py-8 sm:py-12 space-y-12">
    <header class="border-b border-[#e5e5e0] pb-8">
      <h1 class="font-serif text-3xl sm:text-5xl font-bold tracking-tight text-[#1a1a1a]">
        {t.archiveTitle}
      </h1>
      <p class="font-serif text-lg text-[#525252] mt-3 max-w-2xl">
        {t.archiveSubtitle}
      </p>
    </header>

    {years.length === 0 ? (
      <div class="py-12 text-center text-[#737373] font-serif">
        {t.noArticlesFound}
      </div>
    ) : (
      <div class="space-y-16">
        {years.map((year) => {
          const articles = archiveMap.get(year) || [];
          return (
            <section class="space-y-6">
              <div class="flex items-center gap-4 border-b border-[#e5e5e0] pb-3">
                <span class="font-serif text-3xl sm:text-4xl font-bold text-[#1a1a1a]">
                  {year}
                </span>
                <span class="text-xs font-mono text-[#737373]">
                  ({articles.length} pieces)
                </span>
              </div>

              <div class="divide-y divide-[#ecebe6]">
                {articles.map((article) => {
                  const readingMin = calculateReadingMetrics(article.body || '', locale).minutes;
                  return (
                    <article class="group py-5 flex flex-col sm:flex-row sm:items-baseline justify-between gap-3 hover:bg-[#faf8f2] px-3 -mx-3 rounded-sm transition-colors">
                      <div class="space-y-1 max-w-3xl">
                        <div class="flex items-center gap-2 text-xs font-mono text-[#737373]">
                          <Calendar className="h-3 w-3" />
                          <span>{article.data.pubDate}</span>
                          <span class="text-[#d4d4d4]">•</span>
                          <span class="uppercase text-[10px] tracking-wider font-sans text-[#525252]">
                            {article.data.category}
                          </span>
                        </div>
                        <h2 class="font-serif text-lg sm:text-xl font-bold text-[#1a1a1a] group-hover:underline">
                          <a href={`/${locale}/blog/${article.data.slug}`}>
                            {article.data.title}
                          </a>
                        </h2>
                      </div>

                      <div class="text-xs font-mono text-[#a3a3a3] shrink-0">
                        {t.readingTimeFormat(readingMin)}
                      </div>
                    </article>
                  );
                })}
              </div>
            </section>
          );
        })}
      </div>
    )}
  </div>
</BaseLayout>
