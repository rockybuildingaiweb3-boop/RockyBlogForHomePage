---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { ArrowUpRight } from 'lucide-react';
import { siteConfig } from '../../../config/site.config';
import { getTagDisplayName, tagsConfig } from '../../../config/tags';
import { getArticlesByLocale } from '../../../lib/content';
import { uiTranslations } from '../../../i18n/translations';
import type { SupportedLocale } from '../../../types/content';

export function getStaticPaths() {
  return siteConfig.supportedLocales.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: SupportedLocale };
const t = uiTranslations[locale];

const allPosts = await getCollection('blog');
const publishedArticles = getArticlesByLocale(allPosts, locale, false);

const tagCountMap = new Map<string, number>();
for (const a of publishedArticles) {
  for (const tag of a.data.tags) {
    const key = tag.toLowerCase().trim();
    tagCountMap.set(key, (tagCountMap.get(key) || 0) + 1);
  }
}

const allKnownTagIds = Array.from(
  new Set([...Object.keys(tagsConfig), ...Array.from(tagCountMap.keys())])
);

const sortedTags = allKnownTagIds.map((tagId) => ({
  id: tagId,
  displayName: getTagDisplayName(tagId, locale),
  description: tagsConfig[tagId]?.description?.[locale],
  count: tagCountMap.get(tagId) || 0,
})).sort((a, b) => b.count - a.count || a.displayName.localeCompare(b.displayName));

const canonicalUrl = `${siteConfig.siteUrl}/${locale}/tags`;

const alternateHreflangs = Object.fromEntries(
  siteConfig.supportedLocales.map((loc) => [loc, `${siteConfig.siteUrl}/${loc}/tags`])
) as Record<SupportedLocale, string>;

const translationLinks = Object.fromEntries(
  siteConfig.supportedLocales.map((loc) => [loc, { url: `/${loc}/tags`, available: true }])
) as Record<SupportedLocale, { url: string; available: boolean }>;
---

<BaseLayout
  locale={locale}
  title={`${t.tagsLabel} — ${siteConfig.siteName[locale]}`}
  description={`${t.tagsLabel} — ${siteConfig.siteDescription[locale]}`}
  canonicalUrl={canonicalUrl}
  alternateHreflangs={alternateHreflangs}
  translationLinks={translationLinks}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-8 lg:px-12 py-10 sm:py-16 space-y-12">
    <!-- Masthead -->
    <header class="border-b border-[#1b1a18] pb-8 space-y-4">
      <div class="flex items-center gap-3 text-xs font-mono uppercase tracking-widest text-[#88847b]">
        <span>TAXONOMY</span>
        <span>·</span>
        <span>{sortedTags.length} TOPICS REGISTERED</span>
      </div>
      <h1 class="font-serif text-4xl sm:text-6xl font-bold tracking-tight text-[#1b1a18]">
        {t.tagsLabel}
      </h1>
      <p class="font-serif text-lg text-[#57544e] max-w-2xl leading-relaxed">
        {locale === 'zh-CN' && '按技术领域、框架、工程模式与实践主题索引所有技术文章。'}
        {locale === 'en' && 'Index of software engineering articles, AI practices, frameworks, and architecture notes organized by topic.'}
        {locale === 'fr' && 'Index thématique des articles de génie logiciel, pratiques IA, frameworks et architecture.'}
        {locale === 'de' && 'Thematischer Index aller Software-Engineering-Artikel, KI-Praktiken und Systemarchitektur.'}
        {locale === 'ja' && 'ソフトウェア工学、AI実践、Web技術、システム設計の記事をトピック別に分類した索引。'}
      </p>
    </header>

    <!-- Tag Index Table -->
    <div class="divide-y divide-[#e6e2d8]">
      {sortedTags.map((tag, idx) => (
        <a
          href={`/${locale}/tag/${encodeURIComponent(tag.id)}`}
          class="group py-6 grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 items-baseline hover:bg-[#f3f0e8]/50 px-2 -mx-2 transition-colors block"
        >
          <div class="md:col-span-3 flex items-baseline justify-between md:justify-start gap-4">
            <span class="text-xs font-mono text-[#88847b]">
              0{idx + 1 < 10 ? `0${idx + 1}` : idx + 1}
            </span>
            <span class="font-serif text-xl font-bold text-[#1b1a18] group-hover:text-[#1e3a5f] transition-colors">
              #{tag.displayName}
            </span>
          </div>

          <div class="md:col-span-7 space-y-1">
            <div class="text-xs font-mono text-[#88847b]">
              slug: {tag.id}
            </div>
            {tag.description && (
              <p class="font-serif text-sm text-[#57544e] leading-relaxed">
                {tag.description}
              </p>
            )}
          </div>

          <div class="md:col-span-2 flex items-baseline justify-between md:justify-end gap-2 text-xs font-mono">
            <span class="text-[#88847b]">
              {tag.count} {tag.count === 1 ? 'article' : 'articles'}
            </span>
            <ArrowUpRight className="h-3.5 w-3.5 text-[#88847b] group-hover:text-[#1b1a18] transition-colors" />
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
