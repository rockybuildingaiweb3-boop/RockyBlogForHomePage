---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { siteConfig } from '../../../config/site.config';
import { getTagDisplayName, tagsConfig } from '../../../config/tags';
import { getArticlesByTag, getArticlesByLocale } from '../../../lib/content';
import { calculateReadingMetrics } from '../../../lib/readingTime';
import { uiTranslations } from '../../../i18n/translations';
import type { SupportedLocale } from '../../../types/content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const published = allPosts.filter((e) => !e.data.draft);

  // Collect all unique tags across all published articles plus predefined tags
  const globalTags = new Set<string>(Object.keys(tagsConfig));
  for (const post of published) {
    for (const tag of post.data.tags) {
      globalTags.add(tag.toLowerCase().trim());
    }
  }

  const paths: { params: { locale: SupportedLocale; tag: string } }[] = [];
  for (const locale of siteConfig.supportedLocales) {
    for (const tag of globalTags) {
      paths.push({
        params: { locale, tag },
      });
    }
  }
  return paths;
}

const { locale, tag } = Astro.params as { locale: SupportedLocale; tag: string };
const t = uiTranslations[locale];

const allPosts = await getCollection('blog');
const normalizedTagId = tag.toLowerCase().trim();
const articles = getArticlesByTag(allPosts, locale, normalizedTagId);
const allArticles = getArticlesByLocale(allPosts, locale, false);

// Compute tag counts for cloud
const tagCounts = new Map<string, number>();
for (const a of allArticles) {
  for (const tItem of a.data.tags) {
    const key = tItem.toLowerCase().trim();
    tagCounts.set(key, (tagCounts.get(key) || 0) + 1);
  }
}
const sortedTags = Array.from(tagCounts.entries()).sort((a, b) => b[1] - a[1]);

const displayName = getTagDisplayName(normalizedTagId, locale);
const canonicalUrl = `${siteConfig.siteUrl}/${locale}/tag/${normalizedTagId}`;

const alternateHreflangs = Object.fromEntries(
  siteConfig.supportedLocales.map((loc) => [loc, `${siteConfig.siteUrl}/${loc}/tag/${normalizedTagId}`])
) as Record<SupportedLocale, string>;

const translationLinks = Object.fromEntries(
  siteConfig.supportedLocales.map((loc) => [loc, { url: `/${loc}/tag/${normalizedTagId}`, available: true }])
) as Record<SupportedLocale, { url: string; available: boolean }>;
---

<BaseLayout
  locale={locale}
  title={`${displayName} — ${t.tagsLabel}`}
  description={`Articles tagged with #${displayName} (${normalizedTagId})`}
  canonicalUrl={canonicalUrl}
  alternateHreflangs={alternateHreflangs}
  translationLinks={translationLinks}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-8 lg:px-12 py-8 sm:py-12 space-y-12">
    <header class="border-b border-[#e5e5e0] pb-8 space-y-4">
      <div class="flex items-center gap-2 text-xs uppercase font-semibold tracking-widest text-[#737373]">
        <a href={`/${locale}/tags`} class="hover:underline">{t.tagsLabel}</a>
        <span>/</span>
        <span class="font-mono text-[#a3a3a3]">{normalizedTagId}</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold tracking-tight text-[#1a1a1a]">
        #{displayName}
      </h1>

      <!-- Tag cloud pill list -->
      <div class="flex flex-wrap gap-2 pt-4">
        {sortedTags.map(([tItem, count]) => {
          const isActive = tItem.toLowerCase() === normalizedTagId;
          const itemDisplayName = getTagDisplayName(tItem, locale);
          return (
            <a
              href={`/${locale}/tag/${encodeURIComponent(tItem)}`}
              class={`inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-mono rounded-sm transition-colors ${
                isActive
                  ? 'bg-[#1a1a1a] text-[#faf9f6]'
                  : 'bg-[#f5f4ef] text-[#525252] hover:bg-[#e8e6e1]'
              }`}
            >
              <span>#{itemDisplayName}</span>
              <span class="text-[10px] opacity-60">({count})</span>
            </a>
          );
        })}
      </div>
    </header>

    <div>
      {articles.length === 0 ? (
        <div class="py-12 text-center text-[#737373] font-serif space-y-2">
          <p>{t.noArticlesFound}</p>
          <a href={`/${locale}/tags`} class="text-xs font-sans underline text-[#1a1a1a]">
            {t.tagsLabel} →
          </a>
        </div>
      ) : (
        <div class="divide-y divide-[#ecebe6]">
          {articles.map((article) => {
            const readingMin = calculateReadingMetrics(article.body || '', locale).minutes;
            return (
              <article class="group py-6 flex flex-col sm:flex-row sm:items-baseline justify-between gap-4 hover:bg-[#faf8f2] px-4 -mx-4 rounded-sm transition-colors">
                <div class="space-y-1">
                  <div class="text-xs font-mono text-[#737373]">
                    {article.data.pubDate} • {article.data.category}
                  </div>
                  <h2 class="font-serif text-xl font-bold text-[#1a1a1a] group-hover:underline">
                    <a href={`/${locale}/blog/${article.data.slug}`}>
                      {article.data.title}
                    </a>
                  </h2>
                  <p class="font-serif text-sm text-[#525252] line-clamp-2">
                    {article.data.description}
                  </p>
                </div>
                <div class="text-xs font-mono text-[#a3a3a3] shrink-0">
                  {t.readingTimeFormat(readingMin)}
                </div>
              </article>
            );
          })}
        </div>
      )}
    </div>
  </div>
</BaseLayout>
