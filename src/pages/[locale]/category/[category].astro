---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { ArrowUpRight } from 'lucide-react';
import { siteConfig } from '../../../config/site.config';
import { getTagDisplayName } from '../../../config/tags';
import { getArticlesByCategory } from '../../../lib/content';
import { calculateReadingMetrics } from '../../../lib/readingTime';
import { uiTranslations } from '../../../i18n/translations';
import type { SupportedLocale } from '../../../types/content';

export function getStaticPaths() {
  const paths: { params: { locale: SupportedLocale; category: string } }[] = [];
  for (const locale of siteConfig.supportedLocales) {
    for (const cat of siteConfig.categories) {
      paths.push({
        params: { locale, category: cat.id },
      });
    }
  }
  return paths;
}

const { locale, category } = Astro.params as { locale: SupportedLocale; category: string };
const t = uiTranslations[locale];
const categoryDef = siteConfig.categories.find((c) => c.id.toLowerCase() === category.toLowerCase());

const allPosts = await getCollection('blog');
const articles = getArticlesByCategory(allPosts, locale, category);

const categoryName = categoryDef ? categoryDef.name[locale] : category;
const canonicalUrl = `${siteConfig.siteUrl}/${locale}/category/${category}`;

const alternateHreflangs: Record<SupportedLocale, string> = {
  'zh-CN': `${siteConfig.siteUrl}/zh-CN/category/${category}`,
  'en': `${siteConfig.siteUrl}/en/category/${category}`,
  'fr': `${siteConfig.siteUrl}/fr/category/${category}`,
  'de': `${siteConfig.siteUrl}/de/category/${category}`,
  'ja': `${siteConfig.siteUrl}/ja/category/${category}`,
};

const translationLinks: Record<SupportedLocale, { url: string; available: boolean }> = {
  'zh-CN': { url: `/zh-CN/category/${category}`, available: true },
  'en': { url: `/en/category/${category}`, available: true },
  'fr': { url: `/fr/category/${category}`, available: true },
  'de': { url: `/de/category/${category}`, available: true },
  'ja': { url: `/ja/category/${category}`, available: true },
};
---

<BaseLayout
  locale={locale}
  title={`${categoryName} — ${t.categoryLabel}`}
  description={categoryDef?.description?.[locale]}
  canonicalUrl={canonicalUrl}
  alternateHreflangs={alternateHreflangs}
  translationLinks={translationLinks}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-8 lg:px-12 py-10 sm:py-16 space-y-12">
    <!-- Category Masthead -->
    <header class="border-b border-[#1b1a18] pb-8 space-y-4">
      <div class="flex items-center gap-3 text-xs font-mono uppercase tracking-widest text-[#88847b]">
        <span>TOPIC INDEX</span>
        <span>·</span>
        <span>{articles.length} {articles.length === 1 ? 'RECORD' : 'RECORDS'}</span>
      </div>

      <h1 class="font-serif text-4xl sm:text-6xl font-bold tracking-tight text-[#1b1a18]">
        {categoryName}
      </h1>

      {categoryDef?.description?.[locale] && (
        <p class="font-serif text-lg text-[#57544e] max-w-2xl leading-relaxed">
          {categoryDef.description[locale]}
        </p>
      )}

      <!-- Minimalist Category Navigation Strip -->
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 pt-4 border-t border-[#e6e2d8] text-xs font-mono">
        {siteConfig.categories.map((cat, idx) => {
          const isActive = cat.id === category;
          return (
            <a
              href={`/${locale}/category/${cat.id}`}
              class={`transition-colors py-1 ${
                isActive
                  ? 'text-[#1b1a18] font-bold underline underline-offset-4 decoration-1 decoration-[#1b1a18]'
                  : 'text-[#88847b] hover:text-[#1b1a18]'
              }`}
            >
              0{idx + 1} / {cat.name[locale]}
            </a>
          );
        })}
      </div>
    </header>

    <!-- Articles Catalog List -->
    {articles.length === 0 ? (
      <div class="py-20 text-center text-[#88847b] font-serif text-lg">
        {t.noArticlesFound}
      </div>
    ) : (
      <div class="divide-y divide-[#e6e2d8]">
        {articles.map((article, idx) => {
          const readingMin = calculateReadingMetrics(article.body || '', locale).minutes;
          return (
            <article class="group py-8 grid grid-cols-1 md:grid-cols-12 gap-6 items-baseline hover:bg-[#f3f0e8]/50 px-2 -mx-2 transition-colors">
              <div class="md:col-span-3 space-y-1 font-mono text-xs">
                <div class="text-[#1b1a18] font-medium">{article.data.pubDate}</div>
                <div class="text-[11px] uppercase tracking-wider text-[#88847b]">
                  ENTRY 0{idx + 1}
                </div>
                <div class="text-[10px] text-[#a5a095]">
                  {t.readingTimeFormat(readingMin)}
                </div>
              </div>

              <div class="md:col-span-7 space-y-2">
                <h2 class="font-serif text-xl sm:text-2xl font-bold text-[#1b1a18] leading-snug group-hover:text-[#1e3a5f] transition-colors">
                  <a href={`/${locale}/blog/${article.data.slug}`}>
                    {article.data.title}
                  </a>
                </h2>
                <p class="font-serif text-sm text-[#57544e] leading-relaxed line-clamp-2">
                  {article.data.description}
                </p>
                <div class="flex flex-wrap gap-x-3 gap-y-1 pt-1 text-[11px] font-mono text-[#88847b]">
                  {article.data.tags.map((tag: string) => (
                    <a href={`/${locale}/tag/${tag}`} class="hover:text-[#1b1a18]">
                      #{getTagDisplayName(tag, locale)}
                    </a>
                  ))}
                </div>
              </div>

              <div class="hidden md:flex md:col-span-2 justify-end">
                <a
                  href={`/${locale}/blog/${article.data.slug}`}
                  class="inline-flex items-center gap-1 text-xs font-mono uppercase tracking-wider text-[#88847b] group-hover:text-[#1b1a18] group-hover:translate-x-1 transition-all"
                >
                  <span>Read</span>
                  <ArrowUpRight className="h-3 w-3" />
                </a>
              </div>
            </article>
          );
        })}
      </div>
    )}
  </div>
</BaseLayout>
