---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { siteConfig } from '../config/site.config';
import type { SupportedLocale } from '../types/content';
import '../index.css';

export interface Props {
  title?: string;
  description?: string;
  locale: SupportedLocale;
  canonicalUrl?: string;
  alternateHreflangs?: Record<SupportedLocale, string>;
  ogImage?: string;
  ogType?: 'website' | 'article';
  articleDate?: string;
  articleModifiedDate?: string;
  authorName?: string;
  jsonLd?: Record<string, any>;
  translationLinks?: Record<SupportedLocale, { url: string; available: boolean }>;
}

const {
  title,
  description,
  locale,
  canonicalUrl,
  alternateHreflangs,
  ogImage = 'https://images.unsplash.com/photo-1507842229451-7f01be837a27?auto=format&fit=crop&w=1200&q=80',
  ogType = 'website',
  articleDate,
  articleModifiedDate,
  authorName = siteConfig.author.name,
  jsonLd,
  translationLinks,
} = Astro.props;

const siteName = siteConfig.siteName[locale];
const finalTitle = title ? `${title} — ${siteName}` : `${siteName} — ${siteConfig.siteDescription[locale]}`;
const finalDescription = description || siteConfig.siteDescription[locale];
const finalCanonical = canonicalUrl || `${siteConfig.siteUrl}/${locale}`;
const xDefaultUrl = alternateHreflangs?.[siteConfig.defaultLocale] || `${siteConfig.siteUrl}/${siteConfig.defaultLocale}`;
const rssUrl = `${siteConfig.siteUrl}/${locale}/rss.xml`;
---

<!doctype html>
<html lang={locale} class="h-full bg-[#faf9f6] text-[#1a1a1a] antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Core Metadata -->
    <title>{finalTitle}</title>
    <meta name="description" content={finalDescription} />
    <link rel="canonical" href={finalCanonical} />

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;1,400&family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..700&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- Alternate hreflang tags for i18n SEO -->
    {alternateHreflangs &&
      Object.entries(alternateHreflangs).map(([lang, url]) => (
        <link rel="alternate" hreflang={lang} href={url} />
      ))}
    {alternateHreflangs && (
      <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />
    )}

    <!-- Open Graph Metadata -->
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title || siteName} />
    <meta property="og:description" content={finalDescription} />
    <meta property="og:url" content={finalCanonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={locale} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    {ogType === 'article' && articleDate && (
      <meta property="article:published_time" content={articleDate} />
    )}
    {ogType === 'article' && articleModifiedDate && (
      <meta property="article:modified_time" content={articleModifiedDate} />
    )}
    {ogType === 'article' && (
      <meta property="article:author" content={authorName} />
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title || siteName} />
    <meta name="twitter:description" content={finalDescription} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- RSS Feed Alternate Link -->
    <link rel="alternate" type="application/rss+xml" title={`${siteName} RSS Feed`} href={rssUrl} />

    <!-- Structured Data (JSON-LD) -->
    {jsonLd && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body class="flex min-h-full flex-col font-sans selection:bg-[#1a1a1a] selection:text-[#faf9f6]">
    <Header currentLocale={locale} translationLinks={translationLinks} />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer currentLocale={locale} />
  </body>
</html>
