---
import { siteConfig } from '../../config/site.config';
import { localeDisplayNames, uiTranslations } from '../../i18n/translations';
import type { SupportedLocale } from '../../types/content';

export interface Props {
  currentLocale: SupportedLocale;
}

const { currentLocale } = Astro.props;
const t = uiTranslations[currentLocale];
const hasSocial = Boolean(
  siteConfig.author.social.github ||
  siteConfig.author.social.x ||
  siteConfig.author.social.linkedin ||
  siteConfig.author.social.email
);
---

<footer class="border-t border-[#e5e5e0] bg-[#f5f4ef] text-[#525252] transition-colors">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-8 lg:px-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12">
      <!-- Col 1: Masthead & Bio -->
      <div class="md:col-span-2 space-y-4">
        <h3 class="font-serif text-2xl font-bold tracking-tight text-[#1a1a1a]">
          {siteConfig.siteName[currentLocale]}
        </h3>
        <p class="max-w-md text-sm leading-relaxed text-[#525252] font-serif">
          {siteConfig.siteDescription[currentLocale]}
        </p>
        <p class="text-xs text-[#737373] leading-relaxed">
          {siteConfig.author.bio[currentLocale]}
        </p>
      </div>

      <!-- Col 2: Categories -->
      <div class="space-y-3">
        <h4 class="text-xs font-semibold tracking-widest uppercase text-[#1a1a1a]">
          {t.categoriesTitle}
        </h4>
        <ul class="space-y-2 text-sm">
          {siteConfig.categories.map((cat) => (
            <li>
              <a
                href={`/${currentLocale}/category/${cat.id}`}
                class="hover:text-[#1a1a1a] transition-colors"
              >
                {cat.name[currentLocale]}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Languages & Social -->
      <div class="space-y-3">
        <h4 class="text-xs font-semibold tracking-widest uppercase text-[#1a1a1a]">
          {t.languageSwitcherLabel}
        </h4>
        <div class="flex flex-wrap gap-2 text-xs">
          {siteConfig.supportedLocales.map((loc) => (
            <a
              href={`/${loc}`}
              class={`px-2.5 py-1 border rounded-sm transition-colors ${
                loc === currentLocale
                  ? 'border-[#1a1a1a] bg-[#1a1a1a] text-[#faf9f6]'
                  : 'border-[#e5e5e0] bg-[#faf9f6] text-[#525252] hover:border-[#a3a3a3]'
              }`}
            >
              {localeDisplayNames[loc]}
            </a>
          ))}
        </div>

        {hasSocial && (
          <div class="pt-4 space-y-2">
            <h5 class="text-[11px] font-semibold tracking-widest uppercase text-[#737373]">
              Profiles
            </h5>
            <div class="flex flex-wrap gap-3 text-xs">
              {siteConfig.author.social.github && (
                <a
                  href={siteConfig.author.social.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-[#1a1a1a] transition-colors"
                >
                  GitHub
                </a>
              )}
              {siteConfig.author.social.x && (
                <a
                  href={siteConfig.author.social.x}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-[#1a1a1a] transition-colors"
                >
                  X
                </a>
              )}
              {siteConfig.author.social.linkedin && (
                <a
                  href={siteConfig.author.social.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-[#1a1a1a] transition-colors"
                >
                  LinkedIn
                </a>
              )}
              {siteConfig.author.social.email && (
                <a
                  href={siteConfig.author.social.email}
                  class="hover:text-[#1a1a1a] transition-colors"
                >
                  Email
                </a>
              )}
            </div>
          </div>
        )}
      </div>
    </div>

    <!-- Bottom Colophon -->
    <div class="mt-16 border-t border-[#e5e5e0] pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#737373]">
      <div>
        © 2026 {siteConfig.author.name}. All rights reserved.
      </div>
      <div class="flex items-center gap-6">
        <a
          href={`/${currentLocale}/archive`}
          class="hover:text-[#1a1a1a] transition-colors"
        >
          {t.navArchive}
        </a>
        <a
          href={`/${currentLocale}/about`}
          class="hover:text-[#1a1a1a] transition-colors"
        >
          {t.navAbout}
        </a>
      </div>
    </div>
  </div>
</footer>
