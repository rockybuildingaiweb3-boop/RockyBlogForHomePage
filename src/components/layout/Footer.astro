---
import { siteConfig } from '../../config/site.config';
import { localeDisplayNames, uiTranslations } from '../../i18n/translations';
import type { SupportedLocale } from '../../types/content';

export interface Props {
  currentLocale: SupportedLocale;
}

const { currentLocale } = Astro.props;
const t = uiTranslations[currentLocale];
const hasSocial = Boolean(
  siteConfig.author.social.github ||
  siteConfig.author.social.x ||
  siteConfig.author.social.linkedin ||
  siteConfig.author.social.email
);
---

<footer class="border-t border-[#e6e2d8] bg-[#f4f2eb] text-[#57544e] transition-colors">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-8 lg:px-12">
    <!-- Main Colophon Grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-16">
      <!-- Col 1: Editorial Identity & Purpose (6 cols) -->
      <div class="md:col-span-6 space-y-5">
        <div class="space-y-2">
          <div class="text-[10px] font-mono uppercase tracking-widest text-[#88847b]">
            Colophon & Archive Identity
          </div>
          <h3 class="font-serif text-2xl font-bold tracking-tight text-[#1b1a18]">
            ROCKY
          </h3>
        </div>

        <p class="max-w-lg font-serif text-base leading-relaxed text-[#3b3935]">
          {siteConfig.siteDescription[currentLocale]}
        </p>

        <p class="max-w-lg text-xs leading-relaxed text-[#757168] font-sans">
          {siteConfig.author.bio[currentLocale]}
        </p>

        <div class="pt-2 text-[11px] font-mono text-[#88847b] space-y-1">
          <div>PARADIGM: STATIC BY DEFAULT · ZERO DYNAMIC RUNTIME</div>
          <div>TYPESET IN NEWSREADER & JETBRAINS MONO</div>
        </div>
      </div>

      <!-- Col 2: Topics Index (3 cols) -->
      <div class="md:col-span-3 space-y-4">
        <div class="text-[10px] font-mono uppercase tracking-widest text-[#88847b]">
          01 / Topics Index
        </div>
        <ul class="space-y-2.5 text-xs font-medium">
          {siteConfig.categories.map((cat, idx) => (
            <li>
              <a
                href={`/${currentLocale}/category/${cat.id}`}
                class="hover:text-[#1b1a18] transition-colors flex items-baseline justify-between group"
              >
                <span class="group-hover:underline underline-offset-4">{cat.name[currentLocale]}</span>
                <span class="text-[10px] font-mono text-[#88847b]">0{idx + 1}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Editions & Indices (3 cols) -->
      <div class="md:col-span-3 space-y-4">
        <div class="text-[10px] font-mono uppercase tracking-widest text-[#88847b]">
          02 / Editions
        </div>
        <div class="flex flex-wrap gap-x-3 gap-y-1.5 text-xs font-mono">
          {siteConfig.supportedLocales.map((loc) => (
            <a
              href={`/${loc}`}
              class={`transition-colors ${
                loc === currentLocale
                  ? 'text-[#1b1a18] font-bold underline underline-offset-4'
                  : 'text-[#88847b] hover:text-[#1b1a18]'
              }`}
            >
              {localeDisplayNames[loc]}
            </a>
          ))}
        </div>

        {hasSocial && (
          <div class="pt-4 space-y-2">
            <div class="text-[10px] font-mono uppercase tracking-widest text-[#88847b]">
              03 / External Records
            </div>
            <div class="flex flex-wrap gap-x-4 gap-y-1.5 text-xs">
              {siteConfig.author.social.github && (
                <a
                  href={siteConfig.author.social.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-[#1b1a18] transition-colors"
                >
                  GitHub ↗
                </a>
              )}
              {siteConfig.author.social.x && (
                <a
                  href={siteConfig.author.social.x}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-[#1b1a18] transition-colors"
                >
                  X ↗
                </a>
              )}
              {siteConfig.author.social.linkedin && (
                <a
                  href={siteConfig.author.social.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-[#1b1a18] transition-colors"
                >
                  LinkedIn ↗
                </a>
              )}
              {siteConfig.author.social.email && (
                <a
                  href={siteConfig.author.social.email}
                  class="hover:text-[#1b1a18] transition-colors"
                >
                  Email ↗
                </a>
              )}
            </div>
          </div>
        )}
      </div>
    </div>

    <!-- Bottom Architectural Rule & Copyright -->
    <div class="mt-16 border-t border-[#e6e2d8] pt-8 flex flex-col sm:flex-row items-baseline justify-between gap-4 text-[11px] font-mono text-[#88847b]">
      <div>
        © 2026 {siteConfig.author.name}. All technical writings open under CC BY-NC 4.0.
      </div>
      <div class="flex items-center gap-6">
        <a
          href={`/${currentLocale}/tags`}
          class="hover:text-[#1b1a18] transition-colors"
        >
          {t.navTags}
        </a>
        <a
          href={`/${currentLocale}/archive`}
          class="hover:text-[#1b1a18] transition-colors"
        >
          {t.navArchive}
        </a>
        <a
          href={`/${currentLocale}/about`}
          class="hover:text-[#1b1a18] transition-colors"
        >
          {t.navAbout}
        </a>
      </div>
    </div>
  </div>
</footer>
