---
import { Globe, Menu } from 'lucide-react';
import { siteConfig } from '../../config/site.config';
import { localeDisplayNames, uiTranslations } from '../../i18n/translations';
import type { SupportedLocale } from '../../types/content';

export interface Props {
  currentLocale: SupportedLocale;
  translationLinks?: Record<SupportedLocale, { url: string; available: boolean }>;
}

const { currentLocale, translationLinks } = Astro.props;
const t = uiTranslations[currentLocale];

const navLinks = [
  { label: t.navBlog, path: `/${currentLocale}/blog` },
  { label: t.navCategories, path: `/${currentLocale}/category/${siteConfig.categories[0].id}` },
  { label: t.navTags, path: `/${currentLocale}/tags` },
  { label: t.navArchive, path: `/${currentLocale}/archive` },
  { label: t.navAbout, path: `/${currentLocale}/about` },
];

const fallbackLinks: Record<SupportedLocale, { url: string; available: boolean }> = {
  'zh-CN': { url: '/zh-CN', available: true },
  'en': { url: '/en', available: true },
  'fr': { url: '/fr', available: true },
  'de': { url: '/de', available: true },
  'ja': { url: '/ja', available: true },
};

const activeTranslationLinks = translationLinks || fallbackLinks;
---

<header class="sticky top-0 z-40 w-full border-b border-[#e5e5e0] bg-[#faf9f6]/95 backdrop-blur-md transition-colors">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-8 lg:px-12">
    <!-- Masthead / Brand -->
    <div class="flex items-center gap-6">
      <a
        id="nav-logo"
        href={`/${currentLocale}`}
        class="text-left group block"
      >
        <span class="block font-serif text-xl sm:text-2xl font-bold tracking-tight text-[#1a1a1a] transition-colors group-hover:text-[#404040]">
          {siteConfig.siteName[currentLocale]}
        </span>
        <span class="block text-[10px] tracking-[0.2em] uppercase text-[#737373] font-sans">
          Software & Systems Engineering
        </span>
      </a>
    </div>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-medium tracking-wide text-[#525252]">
      {navLinks.map((link) => (
        <a
          href={link.path}
          id={`nav-link-${link.label}`}
          class="transition-colors hover:text-[#1a1a1a]"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Multilingual Switcher & Utilities -->
    <div class="hidden lg:flex items-center gap-4">
      <div class="flex items-center rounded-sm border border-[#e5e5e0] bg-[#f5f4ef] p-0.5 text-xs">
        <div class="flex items-center px-2 py-1 text-[#737373]" title={t.languageSwitcherLabel}>
          <Globe className="h-3.5 w-3.5 mr-1" />
        </div>
        {siteConfig.supportedLocales.map((loc) => {
          const isActive = loc === currentLocale;
          const linkInfo = activeTranslationLinks[loc];
          const hasTranslation = linkInfo ? linkInfo.available : true;
          const targetUrl = linkInfo ? linkInfo.url : `/${loc}`;

          return (
            <a
              href={targetUrl}
              title={hasTranslation ? `${localeDisplayNames[loc]}` : `${localeDisplayNames[loc]} (${t.translationMissing})`}
              class={`relative rounded-xs px-2.5 py-1 text-[11px] font-medium transition-all ${
                isActive
                  ? 'bg-[#1a1a1a] text-[#faf9f6] shadow-xs'
                  : hasTranslation
                    ? 'text-[#525252] hover:text-[#1a1a1a] hover:bg-[#eae8e1]'
                    : 'text-[#a3a3a3] hover:text-[#525252] opacity-75'
              }`}
            >
              {loc}
              {!hasTranslation && !isActive && (
                <span class="ml-0.5 text-[9px] text-[#a3a3a3]" title={t.translationMissing}>•</span>
              )}
            </a>
          );
        })}
      </div>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      aria-label="Toggle Menu"
      class="p-2 text-[#404040] hover:text-[#1a1a1a] md:hidden focus:outline-hidden"
    >
      <Menu className="h-5 w-5" />
    </button>
  </div>

  <!-- Mobile Dropdown Panel -->
  <div id="mobile-menu-panel" class="hidden border-b border-[#e5e5e0] bg-[#faf9f6] px-6 py-6 md:hidden">
    <nav class="flex flex-col gap-4 text-base font-serif">
      {navLinks.map((link) => (
        <a
          href={link.path}
          class="text-left text-[#404040] hover:text-[#1a1a1a] py-1 border-b border-[#f0eee9]"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="mt-6 pt-4 border-t border-[#e5e5e0]">
      <div class="text-[11px] font-semibold tracking-wider uppercase text-[#737373] mb-3">
        {t.languageSwitcherLabel}
      </div>
      <div class="grid grid-cols-2 gap-2 text-xs">
        {siteConfig.supportedLocales.map((loc) => {
          const isActive = loc === currentLocale;
          const linkInfo = activeTranslationLinks[loc];
          const hasTranslation = linkInfo ? linkInfo.available : true;
          const targetUrl = linkInfo ? linkInfo.url : `/${loc}`;

          return (
            <a
              href={targetUrl}
              class={`flex items-center justify-between p-2.5 rounded-sm border ${
                isActive
                  ? 'border-[#1a1a1a] bg-[#1a1a1a] text-[#faf9f6] font-semibold'
                  : hasTranslation
                    ? 'border-[#e5e5e0] bg-[#f5f4ef] text-[#262626] hover:border-[#a3a3a3]'
                    : 'border-[#e5e5e0] bg-[#faf9f6] text-[#a3a3a3]'
              }`}
            >
              <span>{localeDisplayNames[loc]}</span>
              <span class="text-[10px] font-mono uppercase">
                {hasTranslation ? loc : t.translationMissing}
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const panel = document.getElementById('mobile-menu-panel');
  if (btn && panel) {
    btn.addEventListener('click', () => {
      panel.classList.toggle('hidden');
    });
  }
</script>
