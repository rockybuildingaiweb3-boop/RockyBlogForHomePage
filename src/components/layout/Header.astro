---
import { Menu } from 'lucide-react';
import { siteConfig } from '../../config/site.config';
import { localeDisplayNames, uiTranslations } from '../../i18n/translations';
import type { SupportedLocale } from '../../types/content';

export interface Props {
  currentLocale: SupportedLocale;
  translationLinks?: Record<SupportedLocale, { url: string; available: boolean }>;
}

const { currentLocale, translationLinks } = Astro.props;
const t = uiTranslations[currentLocale];

const navLinks = [
  { label: t.navBlog, path: `/${currentLocale}/blog` },
  { label: t.navCategories, path: `/${currentLocale}/category/${siteConfig.categories[0].id}` },
  { label: t.navTags, path: `/${currentLocale}/tags` },
  { label: t.navArchive, path: `/${currentLocale}/archive` },
  { label: t.navAbout, path: `/${currentLocale}/about` },
];

const fallbackLinks: Record<SupportedLocale, { url: string; available: boolean }> = {
  'zh-CN': { url: '/zh-CN', available: true },
  'en': { url: '/en', available: true },
  'fr': { url: '/fr', available: true },
  'de': { url: '/de', available: true },
  'ja': { url: '/ja', available: true },
};

const activeTranslationLinks = translationLinks || fallbackLinks;
---

<header class="sticky top-0 z-40 w-full border-b border-[#e6e2d8] bg-[#f9f8f5]/95 backdrop-blur-[2px] transition-colors">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3.5 sm:px-8 lg:px-12">
    <!-- Left: Author Brand + Engineering Discipline -->
    <a
      id="nav-logo"
      href={`/${currentLocale}`}
      class="group flex items-baseline gap-2.5 transition-opacity hover:opacity-85"
    >
      <span class="font-serif text-lg font-bold tracking-tight text-[#1b1a18]">
        ROCKY
      </span>
      <span class="hidden sm:inline-block text-[11px] font-mono tracking-wider text-[#88847b]">
        Software · AI · Design
      </span>
    </a>

    <!-- Center: Primary Editorial Navigation -->
    <nav class="hidden md:flex items-center gap-7 text-[13px] font-medium text-[#57544e]">
      {navLinks.map((link) => (
        <a
          href={link.path}
          id={`nav-link-${link.label}`}
          class="transition-colors hover:text-[#1b1a18] py-1"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Right: Lightweight Typographic Language Switcher -->
    <div class="hidden lg:flex items-center gap-2.5 text-[11px] font-mono tracking-wider">
      {siteConfig.supportedLocales.map((loc, idx) => {
        const isActive = loc === currentLocale;
        const linkInfo = activeTranslationLinks[loc];
        const hasTranslation = linkInfo ? linkInfo.available : true;
        const targetUrl = linkInfo ? linkInfo.url : `/${loc}`;
        const shortCode = loc === 'zh-CN' ? 'ZH' : loc.toUpperCase();

        return (
          <div class="flex items-center gap-2.5">
            {idx > 0 && <span class="text-[#d3cebf]">/</span>}
            <a
              href={targetUrl}
              title={hasTranslation ? localeDisplayNames[loc] : `${localeDisplayNames[loc]} (${t.translationMissing})`}
              class={`transition-colors py-0.5 ${
                isActive
                  ? 'text-[#1b1a18] font-bold underline underline-offset-4 decoration-1 decoration-[#1b1a18]'
                  : hasTranslation
                    ? 'text-[#88847b] hover:text-[#1b1a18]'
                    : 'text-[#c8c4b7] line-through cursor-not-allowed'
              }`}
            >
              {shortCode}
            </a>
          </div>
        );
      })}
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      aria-label="Toggle Menu"
      class="p-1.5 text-[#57544e] hover:text-[#1b1a18] md:hidden focus:outline-hidden"
    >
      <Menu className="h-5 w-5" />
    </button>
  </div>

  <!-- Mobile Dropdown Panel -->
  <div id="mobile-menu-panel" class="hidden border-b border-[#e6e2d8] bg-[#f9f8f5] px-6 py-6 md:hidden">
    <div class="text-[10px] font-mono uppercase tracking-widest text-[#88847b] mb-4">
      Navigation
    </div>
    <nav class="flex flex-col gap-3 font-serif text-lg">
      {navLinks.map((link) => (
        <a
          href={link.path}
          class="text-left text-[#1b1a18] hover:text-[#1e3a5f] py-1 border-b border-[#ece8de]"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="mt-6 pt-4 border-t border-[#e6e2d8]">
      <div class="text-[10px] font-mono uppercase tracking-widest text-[#88847b] mb-3">
        Edition / Language
      </div>
      <div class="flex flex-wrap items-center gap-4 text-xs font-mono">
        {siteConfig.supportedLocales.map((loc) => {
          const isActive = loc === currentLocale;
          const linkInfo = activeTranslationLinks[loc];
          const hasTranslation = linkInfo ? linkInfo.available : true;
          const targetUrl = linkInfo ? linkInfo.url : `/${loc}`;
          const shortCode = loc === 'zh-CN' ? 'ZH' : loc.toUpperCase();

          return (
            <a
              href={targetUrl}
              class={`py-1 ${
                isActive
                  ? 'text-[#1b1a18] font-bold border-b border-[#1b1a18]'
                  : hasTranslation
                    ? 'text-[#57544e] hover:text-[#1b1a18]'
                    : 'text-[#c8c4b7] line-through'
              }`}
            >
              {shortCode} ({localeDisplayNames[loc]})
            </a>
          );
        })}
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const panel = document.getElementById('mobile-menu-panel');
  if (btn && panel) {
    btn.addEventListener('click', () => {
      panel.classList.toggle('hidden');
    });
  }
</script>
