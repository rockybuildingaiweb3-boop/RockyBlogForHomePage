{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "pubDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "updatedDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "translationId": {
      "type": "string",
      "minLength": 1
    },
    "lang": {
      "type": "string",
      "enum": [
        "zh-CN",
        "en",
        "fr",
        "de",
        "ja"
      ]
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cover": {
      "type": "string"
    },
    "coverAlt": {
      "type": "string",
      "minLength": 1
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "author": {
      "type": "string"
    },
    "canonicalUrl": {
      "type": "string"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https?:\\/\\/"
          },
          "type": {
            "type": "string",
            "enum": [
              "announcement",
              "full-post",
              "adapted"
            ]
          }
        },
        "required": [
          "platform",
          "url",
          "type"
        ]
      }
    },
    "coverCredit": {
      "type": "object",
      "properties": {
        "author": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "pubDate",
    "slug",
    "translationId",
    "lang",
    "category",
    "tags",
    "cover"
  ]
}